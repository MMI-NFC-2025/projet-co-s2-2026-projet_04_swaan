---
import AccountShell from "../components/AccountShell.astro";
import PbImage from "../components/PbImage.astro";
import {
  getCategoryLabels,
  getDictionaryCategories,
  getImageUrl,
  getSignVideoUrl,
  getSignWord,
  getSignes,
  normalizeSignCategory,
} from "../js/backend.mjs";

const title = "Dictionnaire LSF";
const description =
  "Dictionnaire de signes LSF SWAAN avec catégories corps, animaux, nourriture et gestes du quotidien, conçu pour apprendre et réviser les bases en entreprise.";
const signes = await getSignes();
const categories = getDictionaryCategories(signes);
const categoryLabels = getCategoryLabels();
const heroSigns = signes.slice(0, 4);
const heroSign = heroSigns[0];
---

<AccountShell title={title} description={description} active="dictionnaire">
  <div>
    <section class="grid items-center gap-12 pb-14 lg:grid-cols-(--grid-two-dico)">
      <div>
        <nav class="reveal mb-8 text-sm text-soft" aria-label="Fil d'Ariane">
          <a class="hover:text-dark" href="/">Accueil</a>
          <span class="mx-2">/</span>
          <span>Dictionnaire</span>
        </nav>

        <div class="section-label reveal">Dictionnaire & cours</div>
        <h1 class="reveal max-w-3xl font-serif text-display-sm leading-tight font-light tracking-title text-dark md:text-display-xl lg:text-display-3xl">
          Retrouvez les signes LSF par <em class="title-em">catégorie.</em>
        </h1>
        <p class="reveal mt-7 max-w-xl text-base leading-8 font-light text-mid">
          Cette page rassemble les signes utiles pour apprendre progressivement : gestes du quotidien, corps, animaux et nourriture. Chaque carte prévoit un emplacement vidéo pour intégrer tes démonstrations LSF plus tard.
        </p>

        <div class="reveal mt-10 grid max-w-xl gap-4 sm:grid-cols-(--grid-form-inline)">
          <label class="sr-only" for="sign-search">Rechercher un signe</label>
          <input
            id="sign-search"
            class="min-h-14 rounded-full bg-bg px-6 text-sm text-dark shadow-neu-in outline-none placeholder:text-soft"
            type="search"
            placeholder="Rechercher un signe..."
          />
          <a class="btn btn-accent" href="#signes">Explorer</a>
        </div>
      </div>

      <figure class="reveal relative overflow-hidden rounded-hero-lg bg-bg p-6 shadow-neu-out-lg">
        <div class="absolute top-8 right-8 z-10 rounded-full bg-bg px-4 py-2 text-10 font-medium tracking-card text-pop-dark uppercase shadow-neu-out">
          20 illustrations
        </div>
        <div class="grid gap-5">
          <div class="rounded-card-md bg-bg p-4 shadow-neu-in">
            <img
              class="mx-auto h-77 w-full object-contain md:h-95"
              src={heroSign ? getImageUrl(heroSign, "img_signe") || categories[0]?.image : "/assets/img/logo_swaan.avif"}
              alt="Illustration LSF issue de PocketBase"
              loading="eager"
            />
          </div>
          <div class="grid grid-cols-3 gap-4">
            {
              heroSigns.slice(1, 4).map((signe) => (
                <img class="h-24 rounded-3xl bg-bg object-contain p-3 shadow-neu-out" src={getImageUrl(signe, "img_signe") || "/assets/img/logo_swaan.avif"} alt={`Signe ${getSignWord(signe)}`} loading="lazy" />
              ))
            }
          </div>
        </div>
      </figure>
    </section>

    <section class="pb-8">
      <div class="reveal flex flex-wrap items-center gap-3 rounded-card bg-bg p-3 shadow-neu-in" aria-label="Filtres de catégories">
        <button class="category-filter rounded-full bg-bg px-5 py-3 text-xs font-medium tracking-button text-pop-dark uppercase shadow-neu-in" type="button" data-category="all" aria-pressed="true">
          Tous
        </button>
        {
          categories.map((category) => (
            <button class="category-filter rounded-full bg-bg px-5 py-3 text-xs font-medium tracking-button text-mid uppercase shadow-neu-out hover:text-dark hover:shadow-neu-in" type="button" data-category={category.id} aria-pressed="false">
              {category.label}
            </button>
          ))
        }
        <span id="filter-status" class="ml-auto rounded-full bg-bg px-4 py-2 text-10 font-medium tracking-chip text-soft uppercase shadow-neu-in-sm" aria-live="polite">
          {signes.length} signe{signes.length > 1 ? "s" : ""}
        </span>
      </div>
    </section>

    <section class="py-14">
      <div class="section-label reveal">Cours rapides</div>
      <h2 class="section-title reveal">
        Choisir une catégorie pour <em>apprendre dans l'ordre.</em>
      </h2>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
          categories.map((category) => (
            <article class="reveal neu-card overflow-hidden">
              <div class="flex h-44 items-center justify-center bg-bg p-5 shadow-neu-in">
                <img class="h-full w-full object-contain" src={category.image || "/assets/img/logo_swaan.avif"} alt={`Illustration de la catégorie ${category.label}`} loading="lazy" />
              </div>
              <div class="p-7">
                <p class="mb-2 text-10 font-medium tracking-section text-soft uppercase">Catégorie</p>
                <h3 class="mb-3 font-serif text-3xl font-light text-dark">{category.label}</h3>
                <p class="mb-6 text-sm leading-7 font-light text-mid">{category.intro}</p>
                <a
                  class="category-jump inline-flex rounded-full bg-bg px-5 py-2.5 text-xs font-medium tracking-button text-pop-dark uppercase shadow-neu-out hover:shadow-neu-in"
                  href="#signes"
                  data-category={category.id}
                >
                  Voir les signes
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="signes" class="py-8">
      <div class="section-label reveal">Signes</div>
      <h2 class="section-title reveal">
        Des cartes prêtes pour tes <em>vidéos LSF.</em>
      </h2>

      <div id="sign-grid" class="grid gap-7 md:grid-cols-2 xl:grid-cols-4">
        {
          signes.map((signe) => {
            const word = getSignWord(signe);
            const category = normalizeSignCategory(signe.categorie || signe.category);
            const categoryLabel = categoryLabels[category] || signe.categorie || "Signe";
            const level = signe.level || signe.niveau || "Débutant";
            const videoUrl = getSignVideoUrl(signe);

            return (
              <article
                id={`${category}-${word.toLowerCase().replaceAll(" ", "-")}`}
                class="sign-card flex flex-col rounded-card bg-bg p-4 shadow-neu-out transition hover:shadow-neu-in"
                data-category={category}
                data-title={`${word} ${categoryLabel}`.toLowerCase()}
              >
                <div class="relative mb-5 overflow-hidden rounded-img bg-bg shadow-neu-in">
                  {
                    videoUrl ? (
                      <video class="aspect-video w-full object-cover" controls preload="metadata">
                        <source src={videoUrl} type="video/mp4" />
                      </video>
                    ) : (
                      <div class="flex aspect-video flex-col items-center justify-center gap-3 px-4 text-center">
                        <PbImage
                          record={signe}
                          imageField="img_signe"
                          alt={`Illustration du signe ${word}`}
                          width={300}
                          height={220}
                          class="max-h-24 object-contain"
                        />
                      </div>
                    )
                  }
                </div>

                <div class="flex flex-1 flex-col px-2 pb-2">
                  <div class="mb-4 flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-bg px-3 py-1 text-9 font-medium tracking-card text-pop-dark uppercase shadow-neu-in-sm">{categoryLabel}</span>
                    <span class="rounded-full bg-bg px-3 py-1 text-9 font-medium tracking-card text-soft uppercase shadow-neu-in-sm">{level}</span>
                  </div>
                  <h3 class="mb-2 font-serif text-3xl font-light text-dark">{word}</h3>
                  <p class="mb-6 text-sm leading-7 font-light text-mid">{signe.description || "Signe disponible dans le dictionnaire SWAAN."}</p>
                </div>
              </article>
            );
          })
        }
      </div>

      <p id="empty-state" class="mt-10 hidden rounded-3xl bg-bg p-8 text-center text-sm text-mid shadow-neu-in">
        Aucun signe ne correspond à cette recherche.
      </p>
    </section>
  </div>

  <script>
    const searchInput = document.getElementById("sign-search");
    const filterButtons = Array.from(document.querySelectorAll(".category-filter"));
    const categoryJumps = Array.from(document.querySelectorAll(".category-jump"));
    const signsSection = document.getElementById("signes");
    const emptyState = document.getElementById("empty-state");
    const filterStatus = document.getElementById("filter-status");
    let activeCategory = "all";
    const cards = Array.from(document.querySelectorAll(".sign-card"));

    function setActiveButton(category) {
      filterButtons.forEach((item) => {
        const isActive = item.dataset.category === category;
        item.classList.toggle("text-pop-dark", isActive);
        item.classList.toggle("text-mid", !isActive);
        item.classList.toggle("shadow-neu-in", isActive);
        item.classList.toggle("shadow-neu-out", !isActive);
        item.setAttribute("aria-pressed", String(isActive));
      });
    }

    function refreshCards() {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
        const matchesSearch = !query || card.dataset.title.includes(query);
        const isVisible = matchesCategory && matchesSearch;

        card.classList.toggle("hidden", !isVisible);
        if (isVisible) visibleCount += 1;
      });

      emptyState?.classList.toggle("hidden", visibleCount !== 0);
      if (filterStatus) {
        filterStatus.textContent = `${visibleCount} signe${visibleCount > 1 ? "s" : ""}`;
      }
    }

    function scrollToSigns() {
      signsSection?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.category;
        setActiveButton(activeCategory);
        refreshCards();
        scrollToSigns();
      });
    });

    categoryJumps.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        activeCategory = link.dataset.category;
        setActiveButton(activeCategory);
        refreshCards();
        scrollToSigns();
      });
    });

    searchInput.addEventListener("input", refreshCards);
    refreshCards();
  </script>
</AccountShell>
