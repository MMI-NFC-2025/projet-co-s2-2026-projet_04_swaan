---
import AccountShell from "../components/AccountShell.astro";

const title = "Dictionnaire LSF";
const description =
  "Dictionnaire de signes LSF SWAAN avec catégories corps, animaux, nourriture et gestes du quotidien, conçu pour apprendre et réviser les bases en entreprise.";

const categories = [
  {
    id: "quotidien",
    label: "Gestes du quotidien",
    intro: "Les signes à connaître en premier pour saluer, répondre et interagir simplement.",
    image: "/assets/img/dictionnaire/quotidien-bonjour.png",
  },
  {
    id: "corps",
    label: "Corps",
    intro: "Le vocabulaire utile pour parler du corps, de la santé et des besoins immédiats.",
    image: "/assets/img/dictionnaire/corps-main.png",
  },
  {
    id: "animaux",
    label: "Animaux",
    intro: "Une catégorie ludique pour enrichir le vocabulaire et travailler la mémorisation.",
    image: "/assets/img/dictionnaire/animaux-chat.png",
  },
  {
    id: "nourriture",
    label: "Nourriture",
    intro: "Les signes pratiques pour parler de repas, de boissons et de préférences.",
    image: "/assets/img/dictionnaire/nourriture-eau.png",
  },
];

const signs = [
  {
    word: "Bonjour",
    category: "quotidien",
    level: "Débutant",
    description: "Saluer une personne au début d'un échange.",
    image: "/assets/img/dictionnaire/quotidien-bonjour.png",
    videoUrl: "/assets/video/Bonjour.mp4",
  },
  {
    word: "Merci",
    category: "quotidien",
    level: "Débutant",
    description: "Remercier une personne après une aide ou une information.",
    image: "/assets/img/dictionnaire/quotidien-merci.png",
    videoUrl: "/assets/video/Merci.mp4",
  },
  {
    word: "Oui",
    category: "quotidien",
    level: "Débutant",
    description: "Répondre positivement à une question simple.",
    image: "/assets/img/dictionnaire/quotidien-oui.png",
    videoUrl: "/assets/video/Oui.mp4",
  },
  {
    word: "Non",
    category: "quotidien",
    level: "Débutant",
    description: "Répondre négativement ou indiquer un refus.",
    image: "/assets/img/dictionnaire/quotidien-non.png",
    videoUrl: "/assets/video/Non.mp4",
  },
  {
    word: "Aide",
    category: "quotidien",
    level: "Débutant",
    description: "Demander ou proposer de l'aide dans une situation simple.",
    image: "/assets/img/dictionnaire/quotidien-aide.png",
    videoUrl: "/assets/video/Aide.mp4",
  },
  {
    word: "Main",
    category: "corps",
    level: "Débutant",
    description: "Nommer la main et introduire les mouvements des signes.",
    image: "/assets/img/dictionnaire/corps-main.png",
    videoUrl: "/assets/video/Main.mp4",
  },
  {
    word: "Yeux",
    category: "corps",
    level: "Débutant",
    description: "Parler du regard, de l'observation ou d'une gêne visuelle.",
    image: "/assets/img/dictionnaire/corps-yeux.png",
    videoUrl: "/assets/video/yeux.mp4",
  },
  {
    word: "Tête",
    category: "corps",
    level: "Débutant",
    description: "Nommer une partie du corps dans une situation simple.",
    image: "/assets/img/dictionnaire/corps-tete.png",
    videoUrl: "/assets/video/tête.mp4",
  },
  {
    word: "Coeur",
    category: "corps",
    level: "Intermédiaire",
    description: "Exprimer une émotion, un ressenti ou une notion liée au corps.",
    image: "/assets/img/dictionnaire/corps-coeur.png",
    videoUrl: "/assets/video/coeur.mp4",
  },
  {
    word: "Bouche",
    category: "corps",
    level: "Débutant",
    description: "Nommer la bouche ou indiquer une action liée à la parole.",
    image: "/assets/img/dictionnaire/corps-bouche.png",
    videoUrl: "/assets/video/Bouche.mp4",
  },
  {
    word: "Chat",
    category: "animaux",
    level: "Débutant",
    description: "Découvrir un signe animal simple et mémorisable.",
    image: "/assets/img/dictionnaire/animaux-chat.png",
    videoUrl: "/assets/video/chat.mp4",
  },
  {
    word: "Chien",
    category: "animaux",
    level: "Débutant",
    description: "Associer un signe à un animal courant.",
    image: "/assets/img/dictionnaire/animaux-chien.png",
    videoUrl: "/assets/video/Chien.mp4",
  },
  {
    word: "Oiseau",
    category: "animaux",
    level: "Intermédiaire",
    description: "Travailler la précision du geste et du mouvement.",
    image: "/assets/img/dictionnaire/animaux-oiseau.png",
    videoUrl: "/assets/video/Oiseaux.mp4",
  },
  {
    word: "Poisson",
    category: "animaux",
    level: "Intermédiaire",
    description: "Enrichir le vocabulaire avec un signe visuel facile à retenir.",
    image: "/assets/img/dictionnaire/animaux-poisson.png",
    videoUrl: "/assets/video/poisson.mp4",
  },
  {
    word: "Lapin",
    category: "animaux",
    level: "Intermédiaire",
    description: "Découvrir un signe visuel avec un mouvement simple à mémoriser.",
    image: "/assets/img/dictionnaire/animaux-lapin.png",
    videoUrl: "/assets/video/Lapin.mp4",
  },
  {
    word: "Eau",
    category: "nourriture",
    level: "Débutant",
    description: "Demander ou proposer une boisson.",
    image: "/assets/img/dictionnaire/nourriture-eau.png",
    videoUrl: "/assets/video/Eau.mp4",
  },
  {
    word: "Pain",
    category: "nourriture",
    level: "Débutant",
    description: "Nommer un aliment simple dans une situation de repas.",
    image: "/assets/img/dictionnaire/nourriture-pain.png",
    videoUrl: "/assets/video/Pain.mp4",
  },
  {
    word: "Pomme",
    category: "nourriture",
    level: "Débutant",
    description: "Apprendre un mot concret lié aux aliments du quotidien.",
    image: "/assets/img/dictionnaire/nourriture-pomme.png",
    videoUrl: "/assets/video/Pomme.mp4",
  },
  {
    word: "Café",
    category: "nourriture",
    level: "Intermédiaire",
    description: "Utiliser un signe fréquent dans un contexte professionnel.",
    image: "/assets/img/dictionnaire/nourriture-cafe.png",
    videoUrl: "/assets/video/Café.mp4",
  },
  {
    word: "Repas",
    category: "nourriture",
    level: "Intermédiaire",
    description: "Parler d'un repas ou d'un moment de pause en contexte professionnel.",
    image: "/assets/img/dictionnaire/nourriture-repas.png",
    videoUrl: "/assets/video/Repas.mp4",
  },
];

const categoryById = Object.fromEntries(categories.map((category) => [category.id, category]));
---

<AccountShell title={title} description={description} active="dictionnaire">
  <div>
    <section class="grid items-center gap-12 pb-14 lg:grid-cols-[1fr_0.95fr]">
      <div>
        <nav class="reveal mb-8 text-sm text-soft" aria-label="Fil d'Ariane">
          <a class="hover:text-dark" href="/">Accueil</a>
          <span class="mx-2">/</span>
          <span>Dictionnaire</span>
        </nav>

        <div class="section-label reveal">Dictionnaire & cours</div>
        <h1 class="reveal max-w-3xl font-serif text-[44px] leading-[1.05] font-light tracking-[-1px] text-dark md:text-[64px] lg:text-[76px]">
          Retrouvez les signes LSF par <em class="title-em">catégorie.</em>
        </h1>
        <p class="reveal mt-7 max-w-xl text-base leading-8 font-light text-mid">
          Cette page rassemble les signes utiles pour apprendre progressivement : gestes du quotidien, corps, animaux et nourriture. Chaque carte prévoit un emplacement vidéo pour intégrer tes démonstrations LSF plus tard.
        </p>

        <div class="reveal mt-10 grid max-w-xl gap-4 sm:grid-cols-[1fr_auto]">
          <label class="sr-only" for="sign-search">Rechercher un signe</label>
          <input
            id="sign-search"
            class="min-h-14 rounded-full bg-bg px-6 text-sm text-dark shadow-neu-in outline-none placeholder:text-soft"
            type="search"
            placeholder="Rechercher un signe..."
          />
          <a class="btn btn-accent" href="#signes">Explorer</a>
        </div>
      </div>

      <figure class="reveal relative overflow-hidden rounded-[42px] bg-bg p-6 shadow-neu-out-lg">
        <div class="absolute top-8 right-8 z-10 rounded-full bg-bg px-4 py-2 text-[10px] font-medium tracking-[0.12em] text-pop-dark uppercase shadow-neu-out">
          20 illustrations
        </div>
        <div class="grid gap-5">
          <div class="rounded-[32px] bg-bg p-4 shadow-neu-in">
            <img
              class="mx-auto h-[310px] w-full object-contain md:h-[380px]"
              src="/assets/img/dictionnaire/quotidien-bonjour.png"
              alt="Illustration LSF dans le style visuel de SWAAN"
              loading="eager"
            />
          </div>
          <div class="grid grid-cols-3 gap-4">
            <img class="h-24 rounded-3xl bg-bg object-contain p-3 shadow-neu-out" src="/assets/img/dictionnaire/quotidien-merci.png" alt="Signe merci" loading="lazy" />
            <img class="h-24 rounded-3xl bg-bg object-contain p-3 shadow-neu-out" src="/assets/img/dictionnaire/corps-main.png" alt="Signe main" loading="lazy" />
            <img class="h-24 rounded-3xl bg-bg object-contain p-3 shadow-neu-out" src="/assets/img/dictionnaire/nourriture-eau.png" alt="Signe eau" loading="lazy" />
          </div>
        </div>
      </figure>
    </section>

    <section class="pb-8">
      <div class="reveal flex flex-wrap items-center gap-3 rounded-[30px] bg-bg p-3 shadow-neu-in" aria-label="Filtres de catégories">
        <button class="category-filter rounded-full bg-bg px-5 py-3 text-xs font-medium tracking-[0.08em] text-pop-dark uppercase shadow-neu-in" type="button" data-category="all" aria-pressed="true">
          Tous
        </button>
        {
          categories.map((category) => (
            <button class="category-filter rounded-full bg-bg px-5 py-3 text-xs font-medium tracking-[0.08em] text-mid uppercase shadow-neu-out hover:text-dark hover:shadow-neu-in" type="button" data-category={category.id} aria-pressed="false">
              {category.label}
            </button>
          ))
        }
        <span id="filter-status" class="ml-auto rounded-full bg-bg px-4 py-2 text-[10px] font-medium tracking-[0.1em] text-soft uppercase shadow-neu-in-sm" aria-live="polite">
          20 signes
        </span>
      </div>
    </section>

    <section class="py-14">
      <div class="section-label reveal">Cours rapides</div>
      <h2 class="section-title reveal">
        Choisir une catégorie pour <em>apprendre dans l'ordre.</em>
      </h2>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
          categories.map((category) => (
            <article class="reveal neu-card overflow-hidden">
              <div class="flex h-44 items-center justify-center bg-bg p-5 shadow-neu-in">
                <img class="h-full w-full object-contain" src={category.image} alt={`Illustration de la catégorie ${category.label}`} loading="lazy" />
              </div>
              <div class="p-7">
                <p class="mb-2 text-[10px] font-medium tracking-[0.14em] text-soft uppercase">Catégorie</p>
                <h3 class="mb-3 font-serif text-3xl font-light text-dark">{category.label}</h3>
                <p class="mb-6 text-sm leading-7 font-light text-mid">{category.intro}</p>
                <a
                  class="category-jump inline-flex rounded-full bg-bg px-5 py-2.5 text-xs font-medium tracking-[0.08em] text-pop-dark uppercase shadow-neu-out hover:shadow-neu-in"
                  href="#signes"
                  data-category={category.id}
                >
                  Voir les signes
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="signes" class="py-8">
      <div class="section-label reveal">Signes</div>
      <h2 class="section-title reveal">
        Des cartes prêtes pour tes <em>vidéos LSF.</em>
      </h2>

      <div id="sign-grid" class="grid gap-7 md:grid-cols-2 xl:grid-cols-4">
        {
          signs.map((sign) => {
            const category = categoryById[sign.category];

            return (
              <article
                id={`${sign.category}-${sign.word.toLowerCase()}`}
                class="sign-card reveal flex flex-col rounded-[30px] bg-bg p-4 shadow-neu-out transition hover:shadow-neu-in"
                data-category={sign.category}
                data-title={`${sign.word} ${category.label}`.toLowerCase()}
              >
                <div class="relative mb-5 overflow-hidden rounded-[24px] bg-bg shadow-neu-in">
                  {
                    sign.videoUrl ? (
                      <video class="aspect-video w-full object-cover" controls preload="metadata" poster={sign.image}>
                        <source src={sign.videoUrl} type="video/mp4" />
                      </video>
                    ) : (
                      <div class="flex aspect-video flex-col items-center justify-center gap-3 px-4 text-center">
                        <img class="max-h-24 object-contain" src={sign.image} alt={`Illustration du signe ${sign.word}`} loading="lazy" />
                        <div class="rounded-full bg-bg px-4 py-2 text-[10px] font-medium tracking-[0.12em] text-soft uppercase shadow-neu-out">
                          Emplacement vidéo
                        </div>
                      </div>
                    )
                  }
                </div>

                <div class="flex flex-1 flex-col px-2 pb-2">
                  <div class="mb-4 flex flex-wrap items-center gap-2">
                    <span class="rounded-full bg-bg px-3 py-1 text-[9px] font-medium tracking-[0.12em] text-pop-dark uppercase shadow-neu-in-sm">{category.label}</span>
                    <span class="rounded-full bg-bg px-3 py-1 text-[9px] font-medium tracking-[0.12em] text-soft uppercase shadow-neu-in-sm">{sign.level}</span>
                  </div>
                  <h3 class="mb-2 font-serif text-3xl font-light text-dark">{sign.word}</h3>
                  <p class="mb-6 text-sm leading-7 font-light text-mid">{sign.description}</p>
                </div>
              </article>
            );
          })
        }
      </div>

      <p id="empty-state" class="mt-10 hidden rounded-3xl bg-bg p-8 text-center text-sm text-mid shadow-neu-in">
        Aucun signe ne correspond à cette recherche.
      </p>
    </section>
  </div>

  <script>
    const searchInput = document.getElementById("sign-search");
    const cards = Array.from(document.querySelectorAll(".sign-card"));
    const filterButtons = Array.from(document.querySelectorAll(".category-filter"));
    const categoryJumps = Array.from(document.querySelectorAll(".category-jump"));
    const signsSection = document.getElementById("signes");
    const emptyState = document.getElementById("empty-state");
    const filterStatus = document.getElementById("filter-status");
    let activeCategory = "all";

    function setActiveButton(category) {
      filterButtons.forEach((item) => {
        const isActive = item.dataset.category === category;
        item.classList.toggle("text-pop-dark", isActive);
        item.classList.toggle("text-mid", !isActive);
        item.classList.toggle("shadow-neu-in", isActive);
        item.classList.toggle("shadow-neu-out", !isActive);
        item.setAttribute("aria-pressed", String(isActive));
      });
    }

    function refreshCards() {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
        const matchesSearch = !query || card.dataset.title.includes(query);
        const isVisible = matchesCategory && matchesSearch;

        card.classList.toggle("hidden", !isVisible);
        if (isVisible) visibleCount += 1;
      });

      emptyState?.classList.toggle("hidden", visibleCount !== 0);
      if (filterStatus) {
        filterStatus.textContent = `${visibleCount} signe${visibleCount > 1 ? "s" : ""}`;
      }
    }

    function scrollToSigns() {
      signsSection?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.category;
        setActiveButton(activeCategory);
        refreshCards();
        scrollToSigns();
      });
    });

    categoryJumps.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        activeCategory = link.dataset.category;
        setActiveButton(activeCategory);
        refreshCards();
        scrollToSigns();
      });
    });

    searchInput.addEventListener("input", refreshCards);
  </script>
</AccountShell>
