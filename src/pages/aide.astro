---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Support" description="Redirection vers la page contact SWAAN.">
  <main class="flex min-h-screen items-center justify-center bg-bg px-6 text-center text-dark">
    <section class="max-w-xl rounded-[36px] bg-bg p-8 shadow-neu-out-lg">
      <p class="section-label justify-center">Support</p>
      <h1 class="font-serif text-[44px] leading-[1.05] font-light text-dark">La page contact a bougé.</h1>
      <p class="mt-5 text-sm leading-7 font-light text-mid">
        Le support passe maintenant par le formulaire de contact.
      </p>
      <a class="btn btn-accent mt-7" href="/contact">Ouvrir le contact</a>
    </section>
  </main>

  <script>
    window.setTimeout(() => {
      const target = localStorage.getItem("swaan_user_name") ? "/contact-apprenant" : "/contact";
      window.location.href = target;
    }, 800);
  </script>
</Layout>
