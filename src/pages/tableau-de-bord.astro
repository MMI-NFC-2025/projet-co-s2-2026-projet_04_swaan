---
import AccountShell from "../components/AccountShell.astro";

const goals = [
  "Apprendre 3 nouveaux signes",
  "Réviser un mini-jeu",
  "Terminer ta session quotidienne",
];

const games = [
  {
    title: "Memory",
    subtitle: "Vocabulaire du quotidien",
    href: "/jeu-memoire",
    image: "/assets/img/sign-merci-game.png",
    tag: "Associer",
  },
  {
    title: "Vrai / Faux",
    subtitle: "Expressions courantes",
    href: "/jeu-vrai-faux",
    image: "/assets/img/sign-bonjour-game.png",
    tag: "Réviser",
  },
  {
    title: "Quiz",
    subtitle: "Révision rapide",
    href: "/jeu-quiz",
    image: "/assets/img/sign-attention-game.png",
    tag: "Tester",
  },
  {
    title: "Champ lexical",
    subtitle: "Classer par thème",
    href: "/jeu-champ-lexical",
    image: "/assets/img/sign-merci-game.png",
    tag: "Catégoriser",
  },
];
---

<AccountShell
  title="Tableau de bord"
  description="Tableau de bord connecté SWAAN avec progression, objectifs du jour, statistiques et accès aux jeux LSF."
  active="dashboard"
>
  <header class="mb-9 grid gap-6 xl:grid-cols-[1fr_auto] xl:items-center">
    <div>
      <p class="section-label mb-3">Tableau de bord</p>
      <h1 class="font-serif text-[44px] leading-[1.05] font-light tracking-[-0.5px] text-dark md:text-[58px]">
        Bonjour, <em id="dashboard-name" class="title-em">Leila</em>
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-7 font-light text-mid">
        Continue ta progression LSF, révise avec les mini-jeux et retrouve rapidement les signes importants du quotidien.
      </p>
    </div>

    <label class="flex h-14 w-full max-w-sm items-center gap-3 rounded-full bg-bg px-6 shadow-neu-in xl:w-80">
      <input class="min-w-0 flex-1 bg-transparent text-sm text-dark outline-none placeholder:text-soft" type="search" placeholder="Rechercher un signe..." />
      <span class="text-lg text-pop-dark">⌕</span>
    </label>
  </header>

  <div class="grid gap-7 xl:grid-cols-[0.95fr_1.05fr]">
    <section class="rounded-[32px] bg-bg p-7 shadow-neu-out-lg">
      <div class="mb-5 flex items-start justify-between gap-4">
        <div>
          <p class="text-[10px] font-medium tracking-[0.14em] text-soft uppercase">Ta progression</p>
          <h2 class="mt-2 font-serif text-[34px] leading-none font-light text-dark">Débutant <em id="dashboard-level" class="title-em">1</em></h2>
        </div>
        <span id="dashboard-streak" class="rounded-full bg-bg px-4 py-2 text-[11px] font-medium tracking-[0.1em] text-pop-dark uppercase shadow-neu-in-sm">0 jour</span>
      </div>

      <div class="grid gap-4">
        <div class="rounded-[24px] bg-bg p-5 shadow-neu-in">
          <p class="mb-2 text-sm font-medium text-mid">XP total</p>
          <p class="font-serif text-[42px] leading-none font-light text-dark"><span id="dashboard-xp">0</span> <span class="text-xl text-soft">points</span></p>
        </div>
        <a href="/dictionnaire" class="btn btn-accent w-fit">Continuer ma leçon</a>
      </div>
    </section>

    <section class="rounded-[32px] bg-[#ead7cd] p-7 shadow-neu-out-lg">
      <p class="mb-2 text-[10px] font-medium tracking-[0.14em] text-mid uppercase">Objectifs du jour</p>
      <h2 class="mb-6 font-serif text-[34px] leading-none font-light text-dark">Session quotidienne</h2>
      <div class="grid gap-4">
        {
          goals.map((goal) => (
            <a href={goal.includes("mini-jeu") ? "/jeux" : "/dictionnaire"} class="flex items-center gap-4 rounded-[22px] bg-bg/55 p-4 shadow-neu-in-sm hover:shadow-neu-out">
              <span class="dashboard-goal-icon flex size-9 shrink-0 items-center justify-center rounded-full bg-bg text-pop-dark shadow-neu-out" data-goal={goal}>✓</span>
              <span class="text-sm font-medium text-dark">{goal}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <section class="mt-7 rounded-[32px] bg-bg p-6 shadow-neu-out-lg">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[10px] font-medium tracking-[0.14em] text-soft uppercase">Tes badges</p>
        <h2 class="mt-2 font-serif text-[38px] leading-none font-light text-dark">
          Récompenses <em class="title-em">débloquées.</em>
        </h2>
      </div>
      <p id="dashboard-badges-count" class="rounded-full bg-bg px-5 py-2.5 text-xs font-medium tracking-[0.09em] text-pop-dark uppercase shadow-neu-in-sm">
        0 badge
      </p>
    </div>

    <div id="dashboard-badges" class="grid gap-4 md:grid-cols-2 xl:grid-cols-4" aria-live="polite">
      <article class="rounded-[28px] bg-bg p-5 shadow-neu-in">
        <p class="text-sm font-light text-mid">Chargement des badges...</p>
      </article>
    </div>
  </section>

  <section class="mt-7 rounded-[32px] bg-bg p-6 shadow-neu-out-lg">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[10px] font-medium tracking-[0.14em] text-soft uppercase">Tes mini-jeux</p>
        <h2 class="mt-2 font-serif text-[38px] leading-none font-light text-dark">
          Réviser en <em class="title-em">jouant.</em>
        </h2>
      </div>
      <p class="max-w-sm text-sm leading-7 font-light italic text-mid">
        "J'ai choisi ceux-là pour toi... j'espère que je ne me suis pas trompé !"
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {
        games.map((game) => (
          <a href={game.href} class="group rounded-[30px] bg-bg p-4 shadow-neu-out transition hover:-translate-y-1 hover:shadow-neu-in">
            <div class="mb-4 flex h-44 items-center justify-center rounded-[24px] bg-bg p-3 shadow-neu-in">
              <img src={game.image} alt={`Illustration du jeu ${game.title}`} class="h-full w-full object-contain transition group-hover:scale-[1.03]" loading="lazy" />
            </div>
            <div class="px-2 pb-2">
              <span class="mb-3 inline-flex rounded-full bg-bg px-3 py-1 text-[9px] font-medium tracking-[0.12em] text-pop-dark uppercase shadow-neu-in-sm">
                {game.tag}
              </span>
              <h3 class="font-serif text-[30px] leading-none font-light text-dark">{game.title}</h3>
              <p class="mt-2 text-sm leading-6 font-light text-mid">{game.subtitle}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <div class="mt-7 grid gap-7 xl:grid-cols-[1fr_360px]">
    <section>
      <div class="mb-4 flex items-center justify-between gap-4">
        <h2 class="font-serif text-[36px] font-light text-dark">Tes statistiques</h2>
        <a href="/dictionnaire" class="hidden rounded-full bg-bg px-5 py-2.5 text-xs font-medium tracking-[0.09em] text-pop-dark uppercase shadow-neu-out hover:shadow-neu-in sm:inline-flex">
          Voir les signes
        </a>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <a href="/dictionnaire" class="rounded-[30px] bg-bg p-7 shadow-neu-out-lg hover:shadow-neu-in">
          <p class="mb-4 text-[10px] font-medium tracking-[0.14em] text-soft uppercase">Signes appris</p>
          <div class="mb-4 h-8 rounded-full bg-bg p-1 shadow-neu-in">
            <div id="dashboard-signs-bar" class="h-full w-0 rounded-full bg-pop-light shadow-neu-out"></div>
          </div>
          <p id="dashboard-signs" class="font-serif text-[44px] leading-none font-light text-dark">0</p>
        </a>

        <a href="/jeu-vrai-faux" class="rounded-[30px] bg-bg p-7 shadow-neu-out-lg hover:shadow-neu-in">
          <p class="mb-4 text-[10px] font-medium tracking-[0.14em] text-soft uppercase">Taux de réussite</p>
          <div class="mb-4 h-8 rounded-full bg-bg p-1 shadow-neu-in">
            <div id="dashboard-success-bar" class="h-full w-0 rounded-full bg-pop shadow-neu-out"></div>
          </div>
          <p class="font-serif text-[44px] leading-none font-light text-dark"><span id="dashboard-success">0</span> <span class="text-2xl text-soft">%</span></p>
        </a>
      </div>

      <a href="/tableau-de-bord" class="mt-5 grid gap-6 rounded-[32px] bg-[#ead7cd] p-7 shadow-neu-out-lg md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="mb-2 text-[10px] font-medium tracking-[0.14em] text-mid uppercase">Temps total d'apprentissage</p>
          <p id="dashboard-time" class="font-serif text-[48px] leading-none font-light text-dark">0min</p>
        </div>
        <div class="relative size-28 rounded-full bg-bg p-4 shadow-neu-out">
          <div id="dashboard-time-ring" class="absolute inset-4 rounded-full border-[18px] border-pop-light border-r-transparent"></div>
          <div class="absolute inset-[38px] rounded-full bg-bg shadow-neu-in-sm"></div>
        </div>
      </a>
    </section>

    <section class="rounded-[32px] bg-bg p-6 shadow-neu-out-lg">
      <div class="mb-5">
        <p class="text-[10px] font-medium tracking-[0.14em] text-soft uppercase">Tes mini-jeux</p>
        <h2 class="mt-2 font-serif text-[34px] leading-none font-light text-dark">Réviser en jouant</h2>
      </div>

      <div class="mb-5 rounded-[24px] bg-bg p-5 text-sm leading-7 font-light italic text-mid shadow-neu-in">
        "J'ai choisi ceux-là pour toi... j'espère que je ne me suis pas trompé !"
      </div>

      <div class="grid gap-4">
        {
          games.map((game) => (
            <a href={game.href} class="rounded-[22px] bg-bg px-5 py-4 shadow-neu-out hover:shadow-neu-in">
              <p class="font-medium text-dark">{game.title}</p>
              <p class="mt-1 text-sm font-light text-mid">{game.subtitle}</p>
            </a>
          ))
        }
        <a href="/jeux" class="btn btn-soft mt-1">Voir tous les jeux</a>
      </div>
    </section>
  </div>

  <script>
    function titleCaseName(value) {
      if (!value) return "Leila";
      return value
        .split(/[._\-\s@]+/)
        .filter(Boolean)[0]
        ?.replace(/^./, (char) => char.toUpperCase()) || "Leila";
    }

    const storedName = localStorage.getItem("swaan_user_name");
    const pbAuth = localStorage.getItem("pocketbase_auth");
    let displayName = storedName;

    if (!displayName && pbAuth) {
      try {
        const auth = JSON.parse(pbAuth);
        displayName = auth?.model?.prenom || auth?.model?.name || auth?.model?.email;
      } catch {}
    }

    document.getElementById("dashboard-name").textContent = titleCaseName(displayName);

    function readGameSessions() {
      try {
        return JSON.parse(localStorage.getItem("swaan_game_sessions") || "[]").filter(Boolean);
      } catch {
        return [];
      }
    }

    function formatNumber(value) {
      return new Intl.NumberFormat("fr-FR").format(value);
    }

    function formatMinutes(minutes) {
      if (minutes < 60) return `${minutes}min`;
      const hours = Math.floor(minutes / 60);
      const rest = minutes % 60;
      return rest > 0 ? `${hours}h${String(rest).padStart(2, "0")}` : `${hours}h`;
    }

    function isToday(dateValue) {
      const date = new Date(dateValue);
      const today = new Date();
      return date.toDateString() === today.toDateString();
    }

    const POCKETBASE_URL = "https://swaanpb.tebrouri.fr";

    const defaultBadges = [
      {
        id: "premiere-session",
        name: "Première session",
        description: "Terminer un premier mini-jeu.",
        icon: "✓",
        condition: "1 jeu terminé",
        neededSessions: 1,
      },
      {
        id: "memoire-active",
        name: "Mémoire active",
        description: "Réviser au moins 3 signes.",
        icon: "S",
        condition: "3 signes travaillés",
        neededSigns: 3,
      },
      {
        id: "bon-score",
        name: "Bon score",
        description: "Atteindre 70 % de réussite.",
        icon: "%",
        condition: "70 % de réussite",
        neededSuccess: 70,
      },
      {
        id: "regularite",
        name: "Régularité",
        description: "Apprendre sur deux journées différentes.",
        icon: "2",
        condition: "2 jours actifs",
        neededDays: 2,
      },
    ];

    async function readPocketBaseProgress() {
      const auth = JSON.parse(localStorage.getItem("pocketbase_auth") || "{}");
      const userId = auth?.record?.id || auth?.model?.id;
      const token = auth?.token;
      if (!userId || !token) return [];

      try {
        const filter = encodeURIComponent(`user_id = "${userId}"`);
        const response = await fetch(`${POCKETBASE_URL}/api/collections/progress/records?perPage=100&sort=-completed_at&filter=${filter}`, {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        if (!response.ok) throw new Error(`PocketBase ${response.status}`);
        const data = await response.json();

        return (data.items || []).map((record) => ({
          game: "pocketbase",
          score: Number(record.score || 0),
          total: 100,
          learned: record.completed ? 3 : 0,
          minutes: 6,
          createdAt: record.completed_at || record.updated || record.created,
          fromPocketBase: true,
        }));
      } catch (error) {
        console.error("Erreur lecture progression PocketBase :", error);
        return [];
      }
    }

    async function readPocketBaseBadges() {
      const auth = JSON.parse(localStorage.getItem("pocketbase_auth") || "{}");
      const userId = auth?.record?.id || auth?.model?.id;
      const token = auth?.token;

      try {
        const badgeResponse = await fetch(`${POCKETBASE_URL}/api/collections/badges/records?perPage=100&sort=created`, {
          headers: token ? { Authorization: `Bearer ${token}` } : {},
        });

        if (!badgeResponse.ok) throw new Error(`Badges ${badgeResponse.status}`);
        const badgeData = await badgeResponse.json();
        const badges = badgeData.items || [];

        if (!userId || !token) {
          return badges.map((badge) => ({ ...badge, earned: false }));
        }

        const filter = encodeURIComponent(`user_id = "${userId}"`);
        const earnedResponse = await fetch(`${POCKETBASE_URL}/api/collections/user_badges/records?perPage=100&expand=badge_id&filter=${filter}`, {
          headers: { Authorization: `Bearer ${token}` },
        });

        if (!earnedResponse.ok) throw new Error(`User badges ${earnedResponse.status}`);
        const earnedData = await earnedResponse.json();
        const earnedIds = new Set((earnedData.items || []).map((item) => item.badge_id));

        return badges.map((badge) => ({
          id: badge.id,
          name: badge.name,
          description: badge.description,
          icon: badge.icon,
          condition: badge.condition,
          earned: earnedIds.has(badge.id),
        }));
      } catch (error) {
        console.error("Erreur lecture badges PocketBase :", error);
        return [];
      }
    }

    function buildFallbackBadges(sessions) {
      const totalScore = sessions.reduce((sum, session) => sum + Number(session.score || 0), 0);
      const totalQuestions = sessions.reduce((sum, session) => sum + Number(session.total || 0), 0);
      const totalLearned = sessions.reduce((sum, session) => sum + Number(session.learned || 0), 0);
      const successRate = totalQuestions > 0 ? Math.round((totalScore / totalQuestions) * 100) : 0;
      const activeDays = new Set(sessions.map((session) => new Date(session.createdAt).toDateString())).size;

      return defaultBadges.map((badge) => ({
        ...badge,
        earned:
          (badge.neededSessions && sessions.length >= badge.neededSessions) ||
          (badge.neededSigns && totalLearned >= badge.neededSigns) ||
          (badge.neededSuccess && successRate >= badge.neededSuccess) ||
          (badge.neededDays && activeDays >= badge.neededDays),
      }));
    }

    function renderBadges(badges) {
      const badgesBox = document.getElementById("dashboard-badges");
      const countBox = document.getElementById("dashboard-badges-count");
      if (!badgesBox || !countBox) return;

      const normalizedBadges = badges.length > 0 ? badges : defaultBadges.map((badge) => ({ ...badge, earned: false }));
      const earnedCount = normalizedBadges.filter((badge) => badge.earned).length;

      countBox.textContent = `${earnedCount} ${earnedCount > 1 ? "badges" : "badge"}`;
      badgesBox.innerHTML = normalizedBadges
        .slice(0, 4)
        .map((badge) => {
          const earned = Boolean(badge.earned);
          return `
            <article class="rounded-[28px] bg-bg p-5 shadow-${earned ? "neu-out" : "neu-in"} ${earned ? "" : "opacity-65"}">
              <div class="mb-5 flex items-center justify-between gap-3">
                <span class="flex size-12 items-center justify-center rounded-full bg-bg font-serif text-2xl text-${earned ? "pop-dark" : "soft"} shadow-neu-in-sm">
                  ${badge.icon || "S"}
                </span>
                <span class="rounded-full bg-bg px-3 py-1 text-[9px] font-medium tracking-[0.12em] text-${earned ? "pop-dark" : "soft"} uppercase shadow-neu-in-sm">
                  ${earned ? "Obtenu" : "À débloquer"}
                </span>
              </div>
              <h3 class="font-serif text-[28px] leading-none font-light text-dark">${badge.name || "Badge SWAAN"}</h3>
              <p class="mt-3 text-sm leading-6 font-light text-mid">${badge.description || "Badge lié à la progression."}</p>
              <p class="mt-4 text-[10px] font-medium tracking-[0.12em] text-soft uppercase">${badge.condition || "Progression"}</p>
            </article>
          `;
        })
        .join("");
    }

    function renderDashboardProgress(sessions) {
      const totalScore = sessions.reduce((sum, session) => sum + Number(session.score || 0), 0);
      const totalQuestions = sessions.reduce((sum, session) => sum + Number(session.total || 0), 0);
      const totalLearned = sessions.reduce((sum, session) => sum + Number(session.learned || 0), 0);
      const totalMinutes = sessions.reduce((sum, session) => sum + Number(session.minutes || 0), 0);
      const gamesToday = sessions.filter((session) => isToday(session.createdAt));
      const signsToday = gamesToday.reduce((sum, session) => sum + Number(session.learned || 0), 0);
      const xp = totalScore * 40 + sessions.length * 25;
      const successRate = totalQuestions > 0 ? Math.round((totalScore / totalQuestions) * 100) : 0;
      const level = Math.max(1, Math.min(4, Math.floor(xp / 500) + 1));
      const activeDays = new Set(sessions.map((session) => new Date(session.createdAt).toDateString())).size;

      document.getElementById("dashboard-xp").textContent = formatNumber(xp);
      document.getElementById("dashboard-level").textContent = String(level);
      document.getElementById("dashboard-streak").textContent = `${activeDays} ${activeDays > 1 ? "jours" : "jour"}`;
      document.getElementById("dashboard-signs").textContent = formatNumber(totalLearned);
      document.getElementById("dashboard-success").textContent = String(successRate);
      document.getElementById("dashboard-time").textContent = formatMinutes(totalMinutes);
      document.getElementById("dashboard-signs-bar").style.width = `${Math.min(100, totalLearned * 8)}%`;
      document.getElementById("dashboard-success-bar").style.width = `${successRate}%`;

      const timePercent = Math.min(100, totalMinutes * 4);
      document.getElementById("dashboard-time-ring").style.borderTopColor = timePercent > 25 ? "var(--color-pop)" : "var(--color-pop-light)";
      document.getElementById("dashboard-time-ring").style.borderLeftColor = timePercent > 50 ? "var(--color-pop)" : "var(--color-pop-light)";
      document.getElementById("dashboard-time-ring").style.borderBottomColor = timePercent > 75 ? "var(--color-pop)" : "var(--color-pop-light)";

      document.querySelectorAll(".dashboard-goal-icon").forEach((icon) => {
        const goal = icon.dataset.goal || "";
        const completed =
          (goal.includes("3 nouveaux signes") && signsToday >= 3) ||
          (goal.includes("mini-jeu") && gamesToday.length >= 1) ||
          (goal.includes("session quotidienne") && gamesToday.length >= 1 && signsToday >= 3);

        icon.textContent = completed ? "✓" : "";
        icon.classList.toggle("opacity-40", !completed);
      });
    }

    async function updateDashboardProgress() {
      const pocketBaseSessions = await readPocketBaseProgress();
      const sessions = pocketBaseSessions.length > 0 ? pocketBaseSessions : readGameSessions();
      renderDashboardProgress(sessions);
      const pocketBaseBadges = await readPocketBaseBadges();
      renderBadges(pocketBaseBadges.length > 0 ? pocketBaseBadges : buildFallbackBadges(sessions));
    }

    updateDashboardProgress();
  </script>
</AccountShell>
