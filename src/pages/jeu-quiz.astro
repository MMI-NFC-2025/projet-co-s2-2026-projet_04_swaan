---
import AccountShell from "../components/AccountShell.astro";
import { getGameSignes } from "../js/backend.mjs";

const signes = await getGameSignes();
const firstSign = signes[0];
---

<AccountShell title="Quiz LSF" active="jeux">
  <div class="max-w-6xl">
    <header class="mb-9 grid gap-6 xl:grid-cols-(--grid-form-inline) xl:items-end">
      <div>
        <p class="section-label mb-3">Jeu pédagogique</p>
        <h1 class="font-serif text-display-sm leading-tight font-light text-dark md:text-game-lg">
          Quiz <em class="title-em">LSF.</em>
        </h1>
        <p class="mt-5 max-w-2xl text-sm leading-7 font-light text-mid">
          Observe l'image du signe, puis choisis le mot qui correspond. Chaque partie contient 6 questions tirées du dictionnaire.
        </p>
      </div>

      <a class="btn btn-soft" href="/jeux">Tous les jeux</a>
    </header>

    <section class="mb-7 grid gap-5 md:grid-cols-(--grid-quiz)">
      <article class="rounded-card-sm bg-bg p-6 shadow-neu-out-lg">
        <p class="text-10 font-medium tracking-section text-soft uppercase">Question</p>
        <p class="mt-3 font-serif text-display-sm leading-none font-light text-dark">
          <span id="quiz-current">1</span>/<span id="quiz-total">6</span>
        </p>
      </article>

      <article class="rounded-card-sm bg-bg p-6 shadow-neu-out-lg">
        <p class="text-10 font-medium tracking-section text-soft uppercase">Score</p>
        <p class="mt-3 font-serif text-display-sm leading-none font-light text-pop-dark" id="quiz-score">0</p>
      </article>

      <article class="rounded-card-sm bg-bg p-6 shadow-neu-out-lg">
        <p class="mb-4 text-10 font-medium tracking-section text-soft uppercase">Progression</p>
        <div class="h-5 rounded-full bg-bg p-1 shadow-neu-in" aria-hidden="true">
          <div id="quiz-progress" class="h-full w-0 rounded-full bg-pop transition-all"></div>
        </div>
        <p id="quiz-status" class="mt-4 text-sm leading-7 font-light text-mid" role="status" aria-live="polite">
          Chargement des signes...
        </p>
      </article>
    </section>

    <section class="grid gap-7 xl:grid-cols-(--grid-game) xl:items-stretch">
      <article class="rounded-form bg-bg p-6 shadow-neu-out-lg md:p-8">
        <div class="rounded-card-md bg-bg p-4 shadow-neu-in">
          <img
            id="quiz-image"
            class="mx-auto h-80 w-full object-contain md:h-105"
            src={firstSign?.image || "/assets/img/logo_swaan.avif"}
            alt="Signe LSF à identifier"
            loading="eager"
          />
        </div>
      </article>

      <article class="rounded-form bg-bg p-6 shadow-neu-out-lg md:p-8">
        <p class="mb-3 text-11 font-medium tracking-section text-soft uppercase">Quel mot correspond à ce signe ?</p>
        <h2 id="quiz-question" class="font-serif text-card-xl leading-tight font-light text-dark">
          Choisis la bonne réponse.
        </h2>

        <div id="quiz-options" class="mt-8 grid gap-4 sm:grid-cols-2"></div>

        <div id="quiz-feedback" class="mt-7 hidden rounded-card-sm bg-pop-light/55 p-5 text-sm leading-7 text-pop-dark shadow-neu-in-sm" role="status" aria-live="polite"></div>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <button id="quiz-next" class="btn btn-accent" type="button" disabled>Question suivante</button>
          <button id="quiz-restart" class="btn btn-soft" type="button">Recommencer</button>
        </div>
      </article>
    </section>
  </div>

  <script id="quiz-data" type="application/json" set:html={JSON.stringify(signes)}></script>

  <script>
    import { saveGameProgress } from "../js/backend.mjs";

    const state = {
      signs: JSON.parse(document.getElementById("quiz-data")?.textContent || "[]"),
      round: [],
      current: 0,
      score: 0,
      answered: false,
      total: 6,
      baseTotal: 6,
    };

    const image = document.getElementById("quiz-image");
    const optionsBox = document.getElementById("quiz-options");
    const currentBox = document.getElementById("quiz-current");
    const totalBox = document.getElementById("quiz-total");
    const scoreBox = document.getElementById("quiz-score");
    const progressBar = document.getElementById("quiz-progress");
    const statusBox = document.getElementById("quiz-status");
    const feedbackBox = document.getElementById("quiz-feedback");
    const nextButton = document.getElementById("quiz-next");
    const restartButton = document.getElementById("quiz-restart");

    function shuffle(items) {
      return [...items].sort(() => Math.random() - 0.5);
    }

    function createRound() {
      if (state.signs.length < 4) {
        statusBox.textContent = "Ajoute au moins 4 signes avec image dans PocketBase pour lancer le quiz.";
        optionsBox.innerHTML = "";
        nextButton.disabled = true;
        return;
      }

      state.total = Math.min(state.baseTotal, state.signs.length);
      state.round = shuffle(state.signs).slice(0, state.total);
      state.total = state.round.length;
      state.current = 0;
      state.score = 0;
      state.answered = false;
      totalBox.textContent = String(state.total);
      scoreBox.textContent = "0";
      renderQuestion();
    }

    function getOptions(correctSign) {
      const wrongWords = shuffle(state.signs)
        .map((sign) => sign.word)
        .filter((word) => word !== correctSign.word)
        .slice(0, 3);

      return shuffle([correctSign.word, ...wrongWords]);
    }

    function renderQuestion() {
      const sign = state.round[state.current];
      if (!sign) {
        finishQuiz();
        return;
      }

      state.answered = false;
      currentBox.textContent = String(state.current + 1);
      scoreBox.textContent = String(state.score);
      progressBar.style.width = `${(state.current / state.total) * 100}%`;
      statusBox.textContent = "Observe le signe puis choisis le bon mot.";
      feedbackBox.classList.add("hidden");
      feedbackBox.textContent = "";
      nextButton.disabled = true;

      image.src = sign.image;
      image.alt = "Image d'un signe LSF à identifier";

      optionsBox.innerHTML = "";
      getOptions(sign).forEach((word) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "rounded-panel bg-bg px-6 py-5 text-left text-lg font-medium text-dark shadow-neu-out transition hover:text-pop-dark hover:shadow-neu-in";
        button.textContent = word;
        button.addEventListener("click", () => answerQuestion(word, button));
        optionsBox.appendChild(button);
      });
    }

    function answerQuestion(word, selectedButton) {
      if (state.answered) return;
      state.answered = true;

      const sign = state.round[state.current];
      const isCorrect = word === sign.word;
      const buttons = optionsBox.querySelectorAll("button");

      buttons.forEach((button) => {
        button.disabled = true;
        button.classList.remove("hover:text-pop-dark", "hover:shadow-neu-in");

        if (button.textContent === sign.word) {
          button.classList.add("text-pop-dark", "shadow-neu-in");
        }
      });

      if (isCorrect) {
        state.score += 1;
        selectedButton.classList.add("text-pop-dark");
        feedbackBox.textContent = `Bonne réponse : ${sign.word}.`;
      } else {
        selectedButton.classList.add("text-red-700", "shadow-neu-in");
        feedbackBox.textContent = `Ce signe correspond à : ${sign.word}.`;
      }

      scoreBox.textContent = String(state.score);
      feedbackBox.classList.remove("hidden");
      nextButton.disabled = false;
    }

    function finishQuiz() {
      progressBar.style.width = "100%";
      statusBox.textContent = `Partie terminée : ${state.score}/${state.total}.`;
      image.alt = "Fin du quiz LSF";
      optionsBox.innerHTML = "";
      feedbackBox.classList.remove("hidden");
      feedbackBox.textContent = state.score >= Math.ceil(state.total * 0.7)
        ? "Très bien, tu reconnais déjà plusieurs signes."
        : "Continue à t'entraîner avec le dictionnaire et relance une partie.";
      nextButton.disabled = true;
      localStorage.setItem("swaan_quiz_score", String(state.score));
      saveGameProgress("quiz", state.score, state.total, 6);
    }

    nextButton?.addEventListener("click", () => {
      state.current += 1;
      renderQuestion();
    });

    restartButton?.addEventListener("click", createRound);

    createRound();
  </script>
</AccountShell>
