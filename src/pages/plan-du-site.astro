---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const sections = [
  {
    title: "Pages principales",
    text: "Les pages publiques qui présentent SWAAN, son fonctionnement et les offres pour les entreprises.",
    links: [
      ["Accueil", "/"],
      ["À propos", "/a-propos"],
      ["Tarifs", "/tarifs"],
      ["Demander une démo", "/demande-demo"],
      ["Contact", "/contact"],
    ],
  },
  {
    title: "Ressources",
    text: "Les contenus utiles pour comprendre le projet, préparer une demande ou retrouver une information.",
    links: [
      ["Blog LSF", "/blog"],
      ["Documentation", "/documentation"],
      ["Partenariats", "/partenariats"],
      ["Aide", "/aide"],
      ["Support", "/support"],
    ],
  },
  {
    title: "Accès apprenant",
    text: "Les cours, le dictionnaire, les mini-jeux, le tableau de bord et les paramètres sont réservés aux comptes connectés.",
    links: [
      ["Connexion", "/connexion"],
      ["Voir les offres", "/tarifs"],
      ["Demander une démo", "/demande-demo"],
    ],
  },
  {
    title: "Administration et légal",
    text: "Les pages liées au suivi RH, aux règles d'utilisation et aux informations obligatoires.",
    links: [
      ["Mentions légales", "/mentions-legales"],
      ["Conditions d'utilisation", "/cgu"],
      ["Politique de confidentialité", "/confidentialite"],
      ["Cookies", "/cookies"],
    ],
  },
];
---

<Layout
  title="Plan du site"
  description="Plan du site SWAAN : accès aux pages publiques, ressources, connexion apprenant et pages légales."
>
  <Nav />

  <main id="contenu" class="px-6 pt-32 pb-16 md:px-12 lg:px-20">
    <section class="mx-auto max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-(--grid-two-soft) lg:items-end">
        <div>
          <p class="section-label mb-4">Navigation</p>
          <h1 class="font-serif text-display-md leading-tight font-light text-dark md:text-display-2xl">
            Plan <em class="title-em">du site.</em>
          </h1>
        </div>

        <p class="max-w-2xl text-sm leading-7 font-light text-mid">
          Retrouvez rapidement les pages publiques importantes de SWAAN. Les pages
          de cours, dictionnaire, mini-jeux et suivi de progression restent
          accessibles uniquement depuis l'espace connecté.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          sections.map((section) => (
            <section class="rounded-card-lg bg-bg p-7 shadow-neu-out-lg">
              <p class="mb-3 text-10 font-medium tracking-section text-soft uppercase">
                SWAAN
              </p>
              <h2 class="font-serif text-section-lg leading-none font-light text-dark">
                {section.title}
              </h2>
              <p class="mt-4 text-sm leading-7 font-light text-mid">
                {section.text}
              </p>

              <ul class="mt-6 grid gap-3">
                {section.links.map(([label, href]) => (
                  <li>
                    <a
                      href={href}
                      class="flex items-center justify-between gap-4 rounded-full bg-bg px-5 py-3 text-sm font-medium text-mid shadow-neu-out hover:text-pop-dark hover:shadow-neu-in"
                    >
                      <span>{label}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <section class="mt-8 rounded-card-lg bg-sand p-7 shadow-neu-out-lg">
        <div class="grid gap-6 lg:grid-cols-(--grid-two-soft) lg:items-center">
          <div>
            <p class="text-10 font-medium tracking-section text-mid uppercase">
              Espace réservé
            </p>
            <h2 class="mt-3 font-serif text-section-lg leading-tight font-light text-dark">
              Les pages apprenant ne sont pas listées publiquement.
            </h2>
            <p class="mt-4 max-w-3xl text-sm leading-7 font-light text-mid">
              Pour éviter de donner un accès direct aux contenus réservés, le plan
              du site renvoie seulement vers la connexion, les tarifs et la demande
              de démonstration.
            </p>
          </div>

          <div class="flex flex-col gap-4 sm:flex-row lg:justify-end">
            <a class="btn btn-accent w-fit" href="/connexion">Se connecter</a>
            <a class="btn btn-soft w-fit" href="/tarifs">Voir les offres</a>
          </div>
        </div>
      </section>
    </section>
  </main>

  <Footer />
</Layout>
