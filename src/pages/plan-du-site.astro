---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const sections = [
  {
    title: "Pages principales",
    text: "Les pages publiques qui présentent SWAAN, son fonctionnement et les offres pour les entreprises.",
    links: [
      ["Accueil", "/"],
      ["À propos", "/a-propos"],
      ["Tarifs", "/tarifs"],
      ["Demander une démo", "/demande-demo"],
      ["Contact", "/contact"],
    ],
  },
  {
    title: "Ressources",
    text: "Les contenus utiles pour comprendre le projet, préparer une demande ou retrouver une information.",
    links: [
      ["Blog LSF", "/blog"],
      ["Documentation", "/documentation"],
      ["Partenariats", "/partenariats"],
      ["Aide", "/aide"],
      ["Support", "/support"],
    ],
  },
  {
    title: "Espace apprenant",
    text: "Les pages accessibles une fois connecté à l'espace SWAAN.",
    links: [
      ["Connexion", "/connexion"],
      ["Tableau de bord", "/tableau-de-bord"],
      ["Dictionnaire", "/dictionnaire"],
      ["Jeux", "/jeux"],
      ["Paramètres", "/parametres"],
      ["Contact apprenant", "/contact-apprenant"],
    ],
  },
  {
    title: "Mini-jeux",
    text: "Les exercices de révision pour mémoriser les signes et suivre sa progression.",
    links: [
      ["Quiz LSF", "/jeu-quiz"],
      ["Memory", "/jeu-memoire"],
      ["Vrai ou Faux", "/jeu-vrai-faux"],
      ["Champ lexical", "/jeu-champ-lexical"],
    ],
  },
  {
    title: "Administration et légal",
    text: "Les pages liées au suivi RH, aux règles d'utilisation et aux informations obligatoires.",
    links: [
      ["Espace RH", "/espace-rh"],
      ["Mentions légales", "/mentions-legales"],
      ["Conditions d'utilisation", "/cgu"],
      ["Politique de confidentialité", "/confidentialite"],
      ["Cookies", "/cookies"],
    ],
  },
];
---

<Layout
  title="Plan du site"
  description="Plan du site SWAAN : accès aux pages principales, ressources, espace apprenant, mini-jeux et pages légales."
>
  <Nav />

  <main id="contenu" class="px-6 pt-32 pb-16 md:px-12 lg:px-20">
    <section class="mx-auto max-w-6xl">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="section-label mb-4">Navigation</p>
          <h1 class="font-serif text-[48px] leading-[1.05] font-light text-dark md:text-[72px]">
            Plan <em class="title-em">du site.</em>
          </h1>
        </div>

        <p class="max-w-2xl text-sm leading-7 font-light text-mid">
          Retrouvez rapidement les pages importantes de SWAAN. Les pages de cours,
          dictionnaire et jeux sont prévues pour l'espace connecté.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          sections.map((section) => (
            <section class="rounded-[34px] bg-bg p-7 shadow-neu-out-lg">
              <p class="mb-3 text-[10px] font-medium tracking-[0.14em] text-soft uppercase">
                SWAAN
              </p>
              <h2 class="font-serif text-[36px] leading-none font-light text-dark">
                {section.title}
              </h2>
              <p class="mt-4 text-sm leading-7 font-light text-mid">
                {section.text}
              </p>

              <ul class="mt-6 grid gap-3">
                {section.links.map(([label, href]) => (
                  <li>
                    <a
                      href={href}
                      class="flex items-center justify-between gap-4 rounded-full bg-bg px-5 py-3 text-sm font-medium text-mid shadow-neu-out hover:text-pop-dark hover:shadow-neu-in"
                    >
                      <span>{label}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <section class="mt-8 rounded-[34px] bg-[#ead7cd] p-7 shadow-neu-out-lg">
        <p class="text-[10px] font-medium tracking-[0.14em] text-mid uppercase">
          Accessibilité
        </p>
        <h2 class="mt-3 font-serif text-[36px] leading-none font-light text-dark">
          Une navigation plus facile à retrouver.
        </h2>
        <p class="mt-4 max-w-3xl text-sm leading-7 font-light text-mid">
          Cette page complète le menu principal et le pied de page. Elle permet
          d'avoir un second moyen de navigation, utile pour l'expérience utilisateur
          et pour les critères RGAA liés à la navigation.
        </p>
      </section>
    </section>
  </main>

  <Footer />
</Layout>
