---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const title = "Contact";
const description =
  "Contacter SWAAN pour une question sur la formation LSF en entreprise, une demande de démonstration, un partenariat ou un accompagnement.";

const contactReasons = [
  "Demande de renseignement",
  "Demande de démo",
  "Tarifs et déploiement",
  "Partenariat",
  "Presse ou projet étudiant",
  "Autre demande",
];

const contactCards = [
  {
    title: "Entreprises",
    text: "Préparer une démo, comprendre les parcours ou cadrer un besoin RH/formation.",
  },
  {
    title: "Partenaires",
    text: "Échanger sur les contenus LSF, les collaborations ou les actions d'inclusion.",
  },
  {
    title: "Support",
    text: "Pour les utilisateurs connectés, l'espace apprenant propose un contact plus précis.",
  },
];
---

<Layout title={title} description={description}>
  <Nav />

  <main class="px-6 pt-36 pb-16 md:px-12 lg:px-20">
    <section class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <aside class="lg:sticky lg:top-28">
        <nav class="reveal mb-8 text-sm text-soft" aria-label="Fil d'Ariane">
          <a class="hover:text-dark" href="/">Accueil</a>
          <span class="mx-2">/</span>
          <span>Contact</span>
        </nav>

        <div class="section-label reveal">Nous contacter</div>
        <h1 class="reveal max-w-3xl font-serif text-[44px] leading-[1.05] font-light tracking-[-1px] text-dark md:text-[64px] lg:text-[76px]">
          Parlons de votre projet <em class="title-em">LSF.</em>
        </h1>
        <p class="reveal mt-7 max-w-xl text-base leading-8 font-light text-mid">
          Une question sur SWAAN, une démo à organiser, un partenariat à proposer ou un besoin de formation en entreprise ? Envoyez votre demande, elle sera préparée dans un email clair.
        </p>

        <div class="reveal mt-9 rounded-[38px] bg-bg p-6 shadow-neu-out-lg">
          <img
            class="mx-auto h-72 w-full rounded-[30px] bg-bg object-contain p-5 shadow-neu-in"
            src="/assets/img/dictionnaire/quotidien-aide.png"
            alt="Illustration LSF aide"
            loading="eager"
          />
        </div>

        <div class="reveal mt-7 grid gap-4">
          {
            contactCards.map((card) => (
              <article class="rounded-[28px] bg-bg p-5 shadow-neu-in-sm">
                <h2 class="mb-2 font-serif text-2xl font-light text-dark">{card.title}</h2>
                <p class="text-sm leading-7 font-light text-mid">{card.text}</p>
              </article>
            ))
          }
        </div>
      </aside>

      <section class="reveal rounded-[40px] bg-bg p-6 shadow-neu-out-lg md:p-10">
        <div class="mb-8">
          <p class="mb-3 text-[11px] font-medium tracking-[0.14em] text-soft uppercase">Formulaire public</p>
          <h2 class="font-serif text-[36px] leading-[1.1] font-light text-dark md:text-[44px]">
            Envoyer un message
          </h2>
          <p class="mt-4 text-sm leading-7 font-light text-mid">
            Déjà connecté ? Vous serez automatiquement redirigé vers le formulaire de l'espace apprenant.
          </p>
        </div>

        <form id="contact-form" class="grid gap-5" novalidate>
          <div class="grid gap-5 md:grid-cols-2">
            <label class="grid gap-2 text-sm text-mid">
              Prénom et nom
              <input
                class="min-h-14 rounded-full bg-bg px-6 text-dark shadow-neu-in outline-none placeholder:text-soft"
                name="name"
                type="text"
                placeholder="Votre nom"
                autocomplete="name"
                required
              />
            </label>

            <label class="grid gap-2 text-sm text-mid">
              Email
              <input
                class="min-h-14 rounded-full bg-bg px-6 text-dark shadow-neu-in outline-none placeholder:text-soft"
                name="email"
                type="email"
                placeholder="vous@entreprise.fr"
                autocomplete="email"
                required
              />
            </label>
          </div>

          <div class="grid gap-5 md:grid-cols-2">
            <label class="grid gap-2 text-sm text-mid">
              Motif
              <select class="min-h-14 rounded-full bg-bg px-6 text-dark shadow-neu-in outline-none" name="reason" required>
                <option value="">Choisir un motif</option>
                {contactReasons.map((reason) => <option value={reason}>{reason}</option>)}
              </select>
            </label>

            <label class="grid gap-2 text-sm text-mid">
              Entreprise
              <input
                class="min-h-14 rounded-full bg-bg px-6 text-dark shadow-neu-in outline-none placeholder:text-soft"
                name="company"
                type="text"
                placeholder="Nom de l'entreprise"
              />
            </label>
          </div>

          <label class="grid gap-2 text-sm text-mid">
            Sujet
            <input
              class="min-h-14 rounded-full bg-bg px-6 text-dark shadow-neu-in outline-none placeholder:text-soft"
              name="subject"
              type="text"
              placeholder="Exemple : organiser une démo SWAAN"
              required
            />
          </label>

          <label class="grid gap-2 text-sm text-mid">
            Message
            <textarea
              class="min-h-44 rounded-[30px] bg-bg px-6 py-5 text-dark shadow-neu-in outline-none placeholder:text-soft"
              name="message"
              placeholder="Expliquez votre besoin, votre contexte et le nombre de personnes concernées si vous le connaissez."
              required
            ></textarea>
          </label>

          <div id="contact-error" class="hidden rounded-[26px] bg-red-light/55 p-5 text-sm leading-7 text-red-soft shadow-neu-in-sm" role="alert">
            Merci de remplir tous les champs obligatoires avant d'envoyer.
          </div>

          <div id="contact-success" class="hidden rounded-[30px] bg-pop-light/55 p-6 shadow-neu-in-sm" role="status" aria-live="polite">
            <p class="mb-2 text-[11px] font-medium tracking-[0.14em] text-pop-dark uppercase">Message préparé</p>
            <h3 class="font-serif text-3xl font-light text-dark">Votre email est prêt.</h3>
            <p class="mt-3 text-sm leading-7 font-light text-mid">
              Référence : <span id="contact-reference" class="font-medium text-dark"></span>. Cliquez sur le bouton pour ouvrir votre messagerie.
            </p>
            <a id="contact-mailto" class="btn btn-soft mt-5" href="mailto:contact@swaan.fr">Ouvrir l'email prérempli</a>
          </div>

          <div class="flex flex-col gap-4 pt-2 sm:flex-row">
            <button class="btn btn-accent" type="submit">Préparer le message</button>
            <a class="btn btn-soft" href="/demande-demo">Demander une démo</a>
          </div>
        </form>
      </section>
    </section>
  </main>

  <Footer />

  <script>
    const isConnected = Boolean(localStorage.getItem("swaan_user_name"));
    if (isConnected) {
      window.location.replace("/contact-apprenant");
    }

    const form = document.getElementById("contact-form");
    const errorBox = document.getElementById("contact-error");
    const successBox = document.getElementById("contact-success");
    const referenceBox = document.getElementById("contact-reference");
    const mailtoLink = document.getElementById("contact-mailto");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        errorBox?.classList.remove("hidden");
        successBox?.classList.add("hidden");
        form.reportValidity();
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      const reference = `SWAAN-${Date.now().toString().slice(-6)}`;
      const body = [
        `Référence : ${reference}`,
        `Nom : ${data.name}`,
        `Email : ${data.email}`,
        `Entreprise : ${data.company || "Non renseignée"}`,
        `Motif : ${data.reason}`,
        "",
        "Message :",
        data.message,
      ].join("\n");

      mailtoLink?.setAttribute(
        "href",
        `mailto:contact@swaan.fr?subject=${encodeURIComponent(`[SWAAN] ${data.subject}`)}&body=${encodeURIComponent(body)}`,
      );
      referenceBox.textContent = reference;
      errorBox?.classList.add("hidden");
      successBox?.classList.remove("hidden");
      successBox?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  </script>
</Layout>
