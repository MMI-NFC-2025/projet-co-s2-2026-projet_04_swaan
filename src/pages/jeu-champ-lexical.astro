---
import AccountShell from "../components/AccountShell.astro";
import { getLexicalCategories, getLexicalGameSignes } from "../js/backend.mjs";

const cards = await getLexicalGameSignes();
const categories = getLexicalCategories();
const firstCard = cards[0];
---

<AccountShell
  title="Champ lexical LSF"
  description="Mini-jeu SWAAN pour classer les signes LSF dans le bon champ lexical."
  active="jeux"
>
  <header class="mb-8 flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
    <div>
      <p class="section-label mb-3">Jeu pédagogique</p>
      <h1 class="font-serif text-display-sm leading-tight font-light text-dark md:text-game-lg">
        Champ <em class="title-em">lexical.</em>
      </h1>
      <p class="mt-5 max-w-2xl text-sm leading-7 font-light text-mid">
        Observe le signe affiché, puis choisis le thème auquel il appartient. L'objectif est de créer des associations rapides entre signe et catégorie.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <div class="rounded-2xl bg-bg px-5 py-4 shadow-neu-out">
        <p class="text-9 font-medium tracking-card text-soft uppercase">Question</p>
        <p id="question-count" class="font-serif text-3xl leading-none font-light text-dark">1 / 12</p>
      </div>
      <div class="rounded-2xl bg-bg px-5 py-4 shadow-neu-out">
        <p class="text-9 font-medium tracking-card text-soft uppercase">Score</p>
        <p id="score-count" class="font-serif text-3xl leading-none font-light text-pop-dark">0</p>
      </div>
    </div>
  </header>

  <section class="grid gap-7 xl:grid-cols-(--grid-game)">
    <article class="rounded-card-lg bg-bg p-5 shadow-neu-out-lg md:p-7">
      <div class="mb-5 rounded-card bg-bg p-5 shadow-neu-in">
        <img id="sign-image" class="mx-auto h-72 w-full object-contain" src={firstCard?.image || "/assets/img/logo_swaan.avif"} alt="Signe LSF à classer" />
      </div>
      <p class="text-10 font-medium tracking-section text-soft uppercase">Signe affiché</p>
      <h2 id="sign-word" class="mt-2 font-serif text-display-md leading-none font-light text-dark">Trouve sa catégorie.</h2>
      <p id="feedback" class="mt-5 rounded-img bg-bg p-5 text-sm leading-7 font-medium text-mid shadow-neu-in-sm" role="status" aria-live="polite">
        Choisis le bon champ lexical.
      </p>
    </article>

    <article class="rounded-card-lg bg-bg p-6 shadow-neu-out-lg md:p-8">
      <p class="mb-3 text-10 font-medium tracking-section text-soft uppercase">Catégories</p>
      <h2 class="mb-7 font-serif text-card-xl leading-none font-light text-dark">Où ranger ce signe ?</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          categories.map((category) => (
            <button
              class="category-btn min-h-28 rounded-card-sm bg-bg p-5 text-left shadow-neu-out transition hover:-translate-y-1 hover:shadow-neu-in"
              type="button"
              data-category={category.id}
            >
              <span class="text-10 font-medium tracking-section text-pop-dark uppercase">Champ lexical</span>
              <span class="mt-3 block font-serif text-3xl leading-none font-light text-dark">{category.label}</span>
            </button>
          ))
        }
      </div>

      <div id="end-screen" class="mt-7 hidden rounded-card bg-pop-light/55 p-6 shadow-neu-in-sm">
        <p class="mb-2 text-11 font-medium tracking-section text-pop-dark uppercase">Session terminée</p>
        <h3 class="font-serif text-4xl font-light text-dark">Bravo !</h3>
        <p id="end-message" class="mt-3 text-sm leading-7 font-light text-mid"></p>
        <div class="mt-6 flex flex-wrap gap-4">
          <button id="restart-btn" class="btn btn-accent" type="button">Rejouer</button>
          <a class="btn btn-soft" href="/jeux">Tous les jeux</a>
        </div>
      </div>
    </article>
  </section>

  <script id="champ-cards-data" type="application/json" set:html={JSON.stringify(cards)}></script>
  <script id="champ-categories-data" type="application/json" set:html={JSON.stringify(categories)}></script>

  <script>
    import { saveGameProgress } from "../js/backend.mjs";

    const cards = JSON.parse(document.getElementById("champ-cards-data")?.textContent || "[]");
    const categories = JSON.parse(document.getElementById("champ-categories-data")?.textContent || "[]");
    const signImage = document.getElementById("sign-image");
    const signWord = document.getElementById("sign-word");
    const feedback = document.getElementById("feedback");
    const questionCount = document.getElementById("question-count");
    const scoreCount = document.getElementById("score-count");
    const endScreen = document.getElementById("end-screen");
    const endMessage = document.getElementById("end-message");
    const restartBtn = document.getElementById("restart-btn");
    const buttons = Array.from(document.querySelectorAll(".category-btn"));
    const labels = Object.fromEntries(categories.map((category) => [category.id, category.label]));

    let deck = [];
    let index = 0;
    let score = 0;
    let locked = false;
    let activeCards = [...cards];

    function shuffle(items) {
      return [...items].sort(() => Math.random() - 0.5);
    }

    function renderCard() {
      const card = deck[index];
      if (!card) {
        signWord.textContent = "Aucun signe disponible";
        feedback.textContent = "Ajoute des signes avec image et catégorie dans PocketBase pour lancer ce jeu.";
        buttons.forEach((button) => (button.disabled = true));
        return;
      }

      signImage.src = card.image;
      signImage.alt = "Signe LSF à classer";
      signWord.textContent = "Trouve sa catégorie.";
      questionCount.textContent = `${index + 1} / ${deck.length}`;
      scoreCount.textContent = score;
      feedback.textContent = "Choisis le bon champ lexical.";
      feedback.className = "mt-5 rounded-img bg-bg p-5 text-sm leading-7 font-medium text-mid shadow-neu-in-sm";
      locked = false;

      buttons.forEach((button) => {
        button.disabled = false;
        button.classList.remove("shadow-neu-in", "ring-2", "ring-pop", "ring-red-soft");
        button.classList.add("shadow-neu-out");
      });
    }

    function finishGame() {
      buttons.forEach((button) => (button.disabled = true));
      endMessage.textContent = `Tu as classé ${score} signes sur ${deck.length} dans le bon champ lexical.`;
      endScreen.classList.remove("hidden");
      localStorage.setItem("swaan_champ_lexical_score", String(score));
      saveGameProgress("champ_lexical", score, deck.length, 7);
    }

    function answer(button) {
      if (locked) return;
      locked = true;
      const card = deck[index];
      const isCorrect = button.dataset.category === card.category;
      button.classList.remove("shadow-neu-out");
      button.classList.add("shadow-neu-in", "ring-2", isCorrect ? "ring-pop" : "ring-red-soft");

      if (isCorrect) {
        score += 1;
        scoreCount.textContent = score;
        feedback.textContent = `Correct : ${card.word} appartient à "${labels[card.category]}".`;
        feedback.classList.add("text-pop-dark");
      } else {
        feedback.textContent = `Pas exactement : ${card.word} appartient à "${labels[card.category]}".`;
        feedback.classList.add("text-red-soft");
      }

      setTimeout(() => {
        index += 1;
        if (index >= deck.length) {
          finishGame();
        } else {
          renderCard();
        }
      }, 950);
    }

    function startGame() {
      deck = shuffle(activeCards);
      index = 0;
      score = 0;
      endScreen.classList.add("hidden");
      renderCard();
    }

    buttons.forEach((button) => button.addEventListener("click", () => answer(button)));
    restartBtn.addEventListener("click", startGame);
    startGame();
  </script>
</AccountShell>
