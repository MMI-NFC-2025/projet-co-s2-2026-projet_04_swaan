---
import AccountShell from "../components/AccountShell.astro";

const cards = [
  { word: "Bonjour", category: "quotidien", image: "/assets/img/dictionnaire/quotidien-bonjour.png" },
  { word: "Merci", category: "quotidien", image: "/assets/img/dictionnaire/quotidien-merci.png" },
  { word: "Aide", category: "quotidien", image: "/assets/img/dictionnaire/quotidien-aide.png" },
  { word: "Main", category: "corps", image: "/assets/img/dictionnaire/corps-main.png" },
  { word: "Yeux", category: "corps", image: "/assets/img/dictionnaire/corps-yeux.png" },
  { word: "Bouche", category: "corps", image: "/assets/img/dictionnaire/corps-bouche.png" },
  { word: "Chat", category: "animaux", image: "/assets/img/dictionnaire/animaux-chat.png" },
  { word: "Chien", category: "animaux", image: "/assets/img/dictionnaire/animaux-chien.png" },
  { word: "Oiseau", category: "animaux", image: "/assets/img/dictionnaire/animaux-oiseau.png" },
  { word: "Eau", category: "nourriture", image: "/assets/img/dictionnaire/nourriture-eau.png" },
  { word: "Pain", category: "nourriture", image: "/assets/img/dictionnaire/nourriture-pain.png" },
  { word: "Pomme", category: "nourriture", image: "/assets/img/dictionnaire/nourriture-pomme.png" },
];

const categories = [
  { id: "quotidien", label: "Gestes du quotidien" },
  { id: "corps", label: "Corps" },
  { id: "animaux", label: "Animaux" },
  { id: "nourriture", label: "Nourriture" },
];
---

<AccountShell
  title="Champ lexical LSF"
  description="Mini-jeu SWAAN pour classer les signes LSF dans le bon champ lexical."
  active="jeux"
>
  <header class="mb-8 flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between">
    <div>
      <p class="section-label mb-3">Jeu pédagogique</p>
      <h1 class="font-serif text-[44px] leading-[1.05] font-light text-dark md:text-[58px]">
        Champ <em class="title-em">lexical.</em>
      </h1>
      <p class="mt-5 max-w-2xl text-sm leading-7 font-light text-mid">
        Observe le signe affiché, puis choisis le thème auquel il appartient. L'objectif est de créer des associations rapides entre signe et catégorie.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <div class="rounded-2xl bg-bg px-5 py-4 shadow-neu-out">
        <p class="text-[9px] font-medium tracking-[0.12em] text-soft uppercase">Question</p>
        <p id="question-count" class="font-serif text-3xl leading-none font-light text-dark">1 / 12</p>
      </div>
      <div class="rounded-2xl bg-bg px-5 py-4 shadow-neu-out">
        <p class="text-[9px] font-medium tracking-[0.12em] text-soft uppercase">Score</p>
        <p id="score-count" class="font-serif text-3xl leading-none font-light text-pop-dark">0</p>
      </div>
    </div>
  </header>

  <section class="grid gap-7 xl:grid-cols-[0.9fr_1.1fr]">
    <article class="rounded-[34px] bg-bg p-5 shadow-neu-out-lg md:p-7">
      <div class="mb-5 rounded-[30px] bg-bg p-5 shadow-neu-in">
        <img id="sign-image" class="mx-auto h-72 w-full object-contain" src="/assets/img/dictionnaire/quotidien-bonjour.png" alt="Signe à classer" />
      </div>
      <p class="text-[10px] font-medium tracking-[0.14em] text-soft uppercase">Signe affiché</p>
      <h2 id="sign-word" class="mt-2 font-serif text-[48px] leading-none font-light text-dark">Bonjour</h2>
      <p id="feedback" class="mt-5 rounded-[24px] bg-bg p-5 text-sm leading-7 font-medium text-mid shadow-neu-in-sm" role="status" aria-live="polite">
        Choisis le bon champ lexical.
      </p>
    </article>

    <article class="rounded-[34px] bg-bg p-6 shadow-neu-out-lg md:p-8">
      <p class="mb-3 text-[10px] font-medium tracking-[0.14em] text-soft uppercase">Catégories</p>
      <h2 class="mb-7 font-serif text-[38px] leading-none font-light text-dark">Où ranger ce signe ?</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {
          categories.map((category) => (
            <button
              class="category-btn min-h-28 rounded-[28px] bg-bg p-5 text-left shadow-neu-out transition hover:-translate-y-1 hover:shadow-neu-in"
              type="button"
              data-category={category.id}
            >
              <span class="text-[10px] font-medium tracking-[0.14em] text-pop-dark uppercase">Champ lexical</span>
              <span class="mt-3 block font-serif text-3xl leading-none font-light text-dark">{category.label}</span>
            </button>
          ))
        }
      </div>

      <div id="end-screen" class="mt-7 hidden rounded-[30px] bg-pop-light/55 p-6 shadow-neu-in-sm">
        <p class="mb-2 text-[11px] font-medium tracking-[0.14em] text-pop-dark uppercase">Session terminée</p>
        <h3 class="font-serif text-4xl font-light text-dark">Bravo !</h3>
        <p id="end-message" class="mt-3 text-sm leading-7 font-light text-mid"></p>
        <div class="mt-6 flex flex-wrap gap-4">
          <button id="restart-btn" class="btn btn-accent" type="button">Rejouer</button>
          <a class="btn btn-soft" href="/jeux">Tous les jeux</a>
        </div>
      </div>
    </article>
  </section>

  <script define:vars={{ cards, categories }}>
    const signImage = document.getElementById("sign-image");
    const signWord = document.getElementById("sign-word");
    const feedback = document.getElementById("feedback");
    const questionCount = document.getElementById("question-count");
    const scoreCount = document.getElementById("score-count");
    const endScreen = document.getElementById("end-screen");
    const endMessage = document.getElementById("end-message");
    const restartBtn = document.getElementById("restart-btn");
    const buttons = Array.from(document.querySelectorAll(".category-btn"));
    const labels = Object.fromEntries(categories.map((category) => [category.id, category.label]));

    let deck = [];
    let index = 0;
    let score = 0;
    let locked = false;

    function shuffle(items) {
      return [...items].sort(() => Math.random() - 0.5);
    }

    function renderCard() {
      const card = deck[index];
      signImage.src = card.image;
      signImage.alt = `Signe ${card.word}`;
      signWord.textContent = card.word;
      questionCount.textContent = `${index + 1} / ${deck.length}`;
      scoreCount.textContent = score;
      feedback.textContent = "Choisis le bon champ lexical.";
      feedback.className = "mt-5 rounded-[24px] bg-bg p-5 text-sm leading-7 font-medium text-mid shadow-neu-in-sm";
      locked = false;

      buttons.forEach((button) => {
        button.disabled = false;
        button.classList.remove("shadow-neu-in", "ring-2", "ring-pop", "ring-red-soft");
        button.classList.add("shadow-neu-out");
      });
    }

    function finishGame() {
      buttons.forEach((button) => (button.disabled = true));
      endMessage.textContent = `Tu as classé ${score} signes sur ${deck.length} dans le bon champ lexical.`;
      endScreen.classList.remove("hidden");
      localStorage.setItem("swaan_champ_lexical_score", String(score));
    }

    function answer(button) {
      if (locked) return;
      locked = true;
      const card = deck[index];
      const isCorrect = button.dataset.category === card.category;
      button.classList.remove("shadow-neu-out");
      button.classList.add("shadow-neu-in", "ring-2", isCorrect ? "ring-pop" : "ring-red-soft");

      if (isCorrect) {
        score += 1;
        scoreCount.textContent = score;
        feedback.textContent = `Correct : ${card.word} appartient à "${labels[card.category]}".`;
        feedback.classList.add("text-pop-dark");
      } else {
        feedback.textContent = `Pas exactement : ${card.word} appartient à "${labels[card.category]}".`;
        feedback.classList.add("text-red-soft");
      }

      setTimeout(() => {
        index += 1;
        if (index >= deck.length) {
          finishGame();
        } else {
          renderCard();
        }
      }, 950);
    }

    function startGame() {
      deck = shuffle(cards);
      index = 0;
      score = 0;
      endScreen.classList.add("hidden");
      renderCard();
    }

    buttons.forEach((button) => button.addEventListener("click", () => answer(button)));
    restartBtn.addEventListener("click", startGame);
    startGame();
  </script>
</AccountShell>
