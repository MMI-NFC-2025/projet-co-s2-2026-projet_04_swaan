---
import InfoPage from "../components/InfoPage.astro";

const sections = [
  {
    label: "1. Responsable",
    title: "Responsable du traitement",
    text: "Les données personnelles collectées sur SWAAN sont gérées par Leila Tebrouri, Leslie Laurent et Khaoula Dhafer dans le cadre du projet pédagogique SWAAN.",
  },
  {
    label: "2. Données",
    title: "Données collectées",
    text: "Lors de l’utilisation de la plateforme, certaines données peuvent être enregistrées.",
    items: [
      "nom ;",
      "prénom ;",
      "adresse e-mail ;",
      "mot de passe chiffré ;",
      "photo de profil ;",
      "entreprise de rattachement ;",
      "progression dans les modules ;",
      "résultats et scores obtenus aux jeux ;",
      "statistiques de connexion.",
    ],
  },
  {
    label: "3. Finalités",
    title: "Finalité des traitements",
    text: "Les données sont utilisées pour créer et gérer les comptes utilisateurs, assurer le fonctionnement de la plateforme, suivre la progression pédagogique, produire des statistiques d’utilisation, améliorer l’expérience utilisateur et garantir la sécurité du service.",
  },
  {
    label: "4. Base légale",
    title: "Base légale",
    text: "Les traitements sont réalisés sur la base de l’exécution du service demandé, de l’intérêt légitime lié à l’amélioration du projet pédagogique et du consentement lorsque celui-ci est requis.",
  },
  {
    label: "5. Conservation",
    title: "Conservation des données",
    text: "Les données sont conservées pendant toute la durée d’utilisation du compte puis supprimées dans un délai raisonnable après sa désactivation.",
  },
  {
    label: "6. Sécurité",
    title: "Sécurité",
    text: "Les données sont stockées sur des serveurs sécurisés. Les mots de passe sont conservés sous forme chiffrée et ne sont jamais visibles par les administrateurs.",
  },
  {
    label: "7. Droits",
    title: "Droits des utilisateurs",
    text: "Conformément au RGPD, chaque utilisateur dispose de droits sur ses données personnelles.",
    items: [
      "droit d’accès ;",
      "droit de rectification ;",
      "droit d’effacement ;",
      "droit à la limitation du traitement ;",
      "droit d’opposition ;",
      "droit à la portabilité de ses données.",
      "Toute demande peut être adressée à leila.tebrouri@gmail.com.",
    ],
  },
  {
    label: "8. Cookies",
    title: "Cookies nécessaires",
    text: "Le site utilise des cookies nécessaires au bon fonctionnement de la plateforme. Ces cookies permettent notamment le maintien de la session utilisateur, l’authentification et les préférences d’utilisation.",
  },
  {
    label: "9. Audience",
    title: "Mesure d’audience",
    text: "SWAAN utilise Umami Analytics afin de mesurer anonymement la fréquentation du site. Les statistiques collectées servent exclusivement à améliorer le service et ne permettent pas d’identifier personnellement les visiteurs.",
  },
  {
    label: "10. Gestion",
    title: "Gestion des cookies",
    text: "L’utilisateur peut configurer son navigateur afin de refuser tout ou partie des cookies. Certaines fonctionnalités peuvent toutefois être affectées par cette désactivation.",
  },
  {
    label: "11. Réclamation",
    title: "Réclamation",
    text: "En cas de difficulté concernant l’utilisation des données personnelles, l’utilisateur peut introduire une réclamation auprès de la CNIL : www.cnil.fr.",
  },
];
---

<InfoPage
  title="Politique de confidentialité et cookies"
  eyebrow="Données personnelles"
  description="Dernière mise à jour : Juin 2026. Cette page explique quelles données sont collectées et comment elles sont utilisées dans SWAAN."
  image="/assets/img/signes-pro-formation.png"
  ctaLabel="Nous contacter"
  ctaHref="/contact"
  secondaryLabel="Voir les CGU"
  secondaryHref="/cgu"
  highlights={[
    { label: "Données", value: "RGPD" },
    { label: "Cookies", value: "Session" },
    { label: "Audience", value: "Umami" },
  ]}
  sections={sections}
/>
