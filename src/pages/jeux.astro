---
import AccountShell from "../components/AccountShell.astro";
import { getGameCatalog } from "../js/backend.mjs";

const games = await getGameCatalog();
---

<AccountShell
  title="Jeux LSF"
  description="Catalogue des mini-jeux SWAAN disponibles dans l'espace apprenant."
  active="jeux"
>
  <header class="mb-10 grid gap-6 xl:grid-cols-(--grid-form-inline) xl:items-end">
    <div>
      <p class="section-label mb-3">Jeux — LSF</p>
      <h1 class="font-serif text-display-sm leading-tight font-light tracking-title-sm text-dark md:text-game-lg">
        Choisir un <em class="title-em">mini-jeu.</em>
      </h1>
      <p class="mt-5 max-w-2xl text-sm leading-7 font-light text-mid">
        Sélectionnez l'exercice que vous voulez faire aujourd'hui : mémorisation, validation rapide ou révision en quiz.
      </p>
    </div>

    <a href="/tableau-de-bord" class="btn btn-soft w-fit">Retour au tableau de bord</a>
  </header>

  <section id="games-grid" class="grid gap-7 md:grid-cols-2 xl:grid-cols-4">
    {
      games.map((game) => (
        <a href={game.href} class="group flex min-h-full flex-col rounded-card-lg bg-bg p-5 shadow-neu-out-lg transition hover:-translate-y-1 hover:shadow-neu-in">
          <div class="mb-5 flex h-64 items-center justify-center rounded-card-sm bg-bg p-5 shadow-neu-in">
            <img src={game.image || "/assets/img/logo_swaan.avif"} alt={`Illustration du jeu ${game.title}`} class="h-full w-full object-contain transition group-hover:scale-103" loading="lazy" />
          </div>

          <div class="flex flex-1 flex-col px-2 pb-2">
            <div class="mb-4 flex flex-wrap gap-2">
              <span class="rounded-full bg-bg px-3 py-1 text-9 font-medium tracking-card text-pop-dark uppercase shadow-neu-in-sm">{game.status}</span>
              <span class="rounded-full bg-bg px-3 py-1 text-9 font-medium tracking-card text-soft uppercase shadow-neu-in-sm">{game.meta}</span>
            </div>
            <h2 class="font-serif text-card-xl leading-none font-light text-dark">{game.title}</h2>
            <p class="mt-2 text-sm font-medium text-pop-dark">{game.subtitle}</p>
            <p class="mt-4 flex-1 text-sm leading-7 font-light text-mid">{game.description}</p>
            <span class="btn btn-accent mt-6 w-fit">Lancer le jeu</span>
          </div>
        </a>
      ))
    }
  </section>
</AccountShell>
