---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getOffres } from "../js/backend.mjs";

const offres = await getOffres();

function formatPrice(value) {
  const number = Number(value || 0);
  return new Intl.NumberFormat("fr-FR").format(number);
}
---

<Layout
  title="Tarifs SWAAN"
  description="Offres et tarifs SWAAN pour les entreprises qui souhaitent former leurs équipes à la Langue des Signes Française."
>
  <Nav />

  <main class="px-6 pt-36 pb-16 md:px-12 lg:px-20">
    <section class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-(--grid-two-soft) lg:items-center">
      <div>
        <nav class="reveal mb-8 text-sm text-soft" aria-label="Fil d'Ariane">
          <a class="hover:text-dark" href="/">Accueil</a>
          <span class="mx-2">/</span>
          <span>Tarifs</span>
        </nav>

        <div class="section-label reveal">Offres entreprise</div>
        <h1 class="reveal max-w-3xl font-serif text-display-sm leading-tight font-light tracking-title text-dark md:text-display-xl lg:text-display-3xl">
          Des tarifs adaptés à la <em class="title-em">taille de votre équipe.</em>
        </h1>
        <p class="reveal mt-7 max-w-xl text-base leading-8 font-light text-mid">
          Choisissez un pack, puis envoyez une demande de démonstration. L’accès à SWAAN est réservé aux structures qui souhaitent former leurs collaborateurs.
        </p>

        <div class="reveal mt-10 flex flex-col gap-4 sm:flex-row">
          <a class="btn btn-accent" href="/demande-demo">Demander une démo</a>
          <a class="btn btn-soft" href="/contact">Nous contacter</a>
        </div>
      </div>

      <aside class="reveal rounded-hero-lg bg-bg p-6 shadow-neu-out-lg">
        <div class="rounded-card-lg bg-bg p-6 shadow-neu-in">
          <img
            class="mx-auto h-72 w-full object-contain md:h-80"
            src="/assets/img/signes-pro-formation.png"
            alt="Illustration SWAAN pour la formation LSF en entreprise"
            loading="eager"
          />
        </div>
      </aside>
    </section>

    <section class="mx-auto mt-16 max-w-7xl">
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <div class="section-label reveal">Packs SWAAN</div>
          <h2 class="section-title reveal">Choisir une offre <em>professionnelle.</em></h2>
        </div>
        <span id="offres-status" class="rounded-full bg-bg px-5 py-2.5 text-xs font-medium tracking-nav text-pop-dark uppercase shadow-neu-in-sm">
          {offres.length} offre{offres.length > 1 ? "s" : ""}
        </span>
      </div>

      <div id="offres-grid" class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          offres.map((offre) => (
            <article class="rounded-card-lg bg-bg p-7 shadow-neu-out-lg">
              <div class="mb-8 flex items-start justify-between gap-4">
                <h3 class="font-serif text-section leading-none font-light text-dark">{offre.nom_pack || "Pack SWAAN"}</h3>
                <span class="rounded-full bg-bg px-4 py-2 text-10 font-medium tracking-card text-pop-dark uppercase shadow-neu-out">
                  B2B
                </span>
              </div>
              <p class="text-10 font-medium tracking-section text-soft uppercase">Mensuel</p>
              <p class="mt-3 font-serif text-display-sm leading-none font-light text-dark">{formatPrice(offre.prix_mois)} € / mois</p>
              <p class="mt-6 text-10 font-medium tracking-section text-soft uppercase">Annuel</p>
              <p class="mt-3 font-serif text-section leading-none font-light text-pop-dark">{formatPrice(offre.prix_annee)} € / an</p>
              <p class="mt-8 text-sm leading-7 font-light text-mid">{offre.description || "Offre entreprise pour accéder à SWAAN."}</p>
              <a class="mt-8 inline-flex rounded-full bg-bg px-5 py-2.5 text-xs font-medium tracking-button text-pop-dark uppercase shadow-neu-out hover:shadow-neu-in" href="/demande-demo">
                Choisir ce pack
              </a>
            </article>
          ))
        }
      </div>
      {
        offres.length === 0 && (
          <p class="rounded-card bg-bg p-8 text-sm leading-7 font-light text-mid shadow-neu-in">
            Aucune offre n'est encore renseignée dans PocketBase.
          </p>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>
