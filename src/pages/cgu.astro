---
import InfoPage from "../components/InfoPage.astro";

const sections = [
  {
    label: "1. Objet",
    title: "Modalités d’accès et d’utilisation",
    text: "Les présentes Conditions Générales d’Utilisation définissent les modalités d’accès et d’utilisation de la plateforme SWAAN.",
  },
  {
    label: "2. Acceptation",
    title: "Acceptation des conditions",
    text: "Toute utilisation du site implique l’acceptation pleine et entière des présentes CGU.",
  },
  {
    label: "3. Accès",
    title: "Accès au service",
    text: "L’accès aux contenus publics du site est libre. L’accès à la plateforme d’apprentissage nécessite la création préalable d’un compte utilisateur par l’équipe SWAAN ou l’administrateur de l’entreprise cliente.",
    items: ["Les identifiants de connexion sont transmis directement à l’utilisateur concerné."],
  },
  {
    label: "4. Compte",
    title: "Compte utilisateur",
    text: "L’utilisateur s’engage à utiliser la plateforme dans le respect de sa finalité pédagogique.",
    items: [
      "conserver la confidentialité de ses identifiants ;",
      "fournir des informations exactes ;",
      "ne pas partager son compte avec un tiers ;",
      "utiliser la plateforme dans le respect de sa finalité pédagogique.",
    ],
  },
  {
    label: "5. Fonctionnalités",
    title: "Fonctionnalités proposées",
    text: "La plateforme peut notamment proposer des modules d’apprentissage LSF, des mini-jeux pédagogiques, un dictionnaire de signes, un suivi de progression, un système de badges et des statistiques d’apprentissage.",
  },
  {
    label: "6. Profil",
    title: "Modification du profil",
    text: "L’utilisateur peut modifier certaines informations de son profil depuis son espace personnel.",
  },
  {
    label: "7. Propriété",
    title: "Propriété intellectuelle",
    text: "Les contenus pédagogiques et les éléments graphiques de SWAAN demeurent la propriété exclusive de leurs auteurs. Toute reproduction ou réutilisation sans autorisation est interdite.",
  },
  {
    label: "8. Suspension",
    title: "Suspension ou suppression d’un compte",
    text: "L’équipe SWAAN se réserve le droit de suspendre ou supprimer un compte dans certains cas.",
    items: [
      "utilisation abusive ;",
      "tentative de fraude ;",
      "non-respect des présentes CGU ;",
      "atteinte au bon fonctionnement de la plateforme.",
    ],
  },
  {
    label: "9. Responsabilité",
    title: "Limitation de responsabilité",
    text: "SWAAN est un outil pédagogique. Les créateurs ne sauraient être tenus responsables d’éventuelles interruptions temporaires du service, pertes de données ou dysfonctionnements techniques.",
  },
  {
    label: "10. Évolution",
    title: "Modification des CGU",
    text: "Les présentes CGU peuvent être modifiées à tout moment afin de tenir compte des évolutions du projet ou des obligations légales.",
  },
  {
    label: "11. Droit",
    title: "Droit applicable",
    text: "Les présentes CGU sont régies par le droit français.",
  },
];
---

<InfoPage
  title="Conditions générales d’utilisation"
  eyebrow="Cadre d’utilisation"
  description="Dernière mise à jour : Juin 2026. Les règles d’accès et d’utilisation de la plateforme SWAAN."
  image="/assets/img/sign-bonjour-game.png"
  ctaLabel="Nous contacter"
  ctaHref="/contact"
  secondaryLabel="Confidentialité"
  secondaryHref="/confidentialite"
  highlights={[
    { label: "Accès", value: "Compte" },
    { label: "Usage", value: "Pédagogique" },
    { label: "Droit", value: "France" },
  ]}
  notice={{
    label: "À retenir",
    text: "SWAAN est une plateforme pédagogique : les comptes apprenants sont créés ou transmis par l’équipe SWAAN ou par l’entreprise cliente.",
  }}
  sections={sections}
/>
