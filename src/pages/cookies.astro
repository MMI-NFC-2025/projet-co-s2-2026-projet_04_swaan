---
import InfoPage from "../components/InfoPage.astro";

const sections = [
  {
    label: "Cookies",
    title: "Cookies nécessaires",
    text: "Le site utilise des cookies nécessaires au bon fonctionnement de la plateforme. Ces cookies permettent notamment le maintien de la session utilisateur, l’authentification et les préférences d’utilisation.",
  },
  {
    label: "Audience",
    title: "Mesure d’audience",
    text: "SWAAN utilise Umami Analytics afin de mesurer anonymement la fréquentation du site. Les statistiques collectées servent exclusivement à améliorer le service et ne permettent pas d’identifier personnellement les visiteurs.",
  },
  {
    label: "Gestion",
    title: "Gestion des cookies",
    text: "L’utilisateur peut configurer son navigateur afin de refuser tout ou partie des cookies. Certaines fonctionnalités peuvent toutefois être affectées par cette désactivation.",
  },
];
---

<InfoPage
  title="Cookies"
  eyebrow="Confidentialité"
  description="Dernière mise à jour : Juin 2026. Les cookies utilisés sur SWAAN servent au fonctionnement de la session, à l’authentification et à la mesure d’audience anonyme."
  image="/assets/img/logo_swaan.avif"
  ctaLabel="Politique complète"
  ctaHref="/confidentialite"
  secondaryLabel="Nous contacter"
  secondaryHref="/contact"
  highlights={[
    { label: "Session", value: "Oui" },
    { label: "Audience", value: "Umami" },
    { label: "Publicité", value: "Non" },
  ]}
  sections={sections}
/>
