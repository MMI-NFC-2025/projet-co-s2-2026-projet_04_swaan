<section id="tarifs" class="py-20 px-6 md:px-20">
  <div class="text-xs uppercase text-[#ADA8A2] font-medium mb-4">Offres et tarifs</div>
  <h2 class="font-serif text-3xl md:text-5xl font-light text-[#3A3530] mb-12">Des offres adaptées à la <em class="italic text-[#6A8A58]">taille de votre équipe.</em></h2>
  <div class="grid md:grid-cols-3 gap-6">
    <!-- Exemple de carte tarif, à dupliquer pour chaque offre -->
    <div class="bg-[#E8E4DF] rounded-2xl p-9 shadow hover:shadow-inner transition flex flex-col">
      <div class="flex items-center justify-between mb-8">
        <div class="font-serif text-xl text-[#3A3530]">Pack 5 utilisateurs</div>
        <span class="bg-[#E8E4DF] rounded-full shadow px-3 py-1 text-[10px] font-medium uppercase text-[#6A8A58]">B2B</span>
      </div>
      <div class="mb-4">
        <div class="text-[10px] uppercase text-[#ADA8A2] mb-1 font-medium">Mensuel</div>
        <div class="font-serif text-3xl text-[#3A3530]">25 € / mois</div>
      </div>
      <div class="mb-4">
        <div class="text-[10px] uppercase text-[#ADA8A2] mb-1 font-medium">Annuel</div>
        <div class="font-serif text-2xl text-[#6A8A58]">250 € / an</div>
      </div>
      <p class="text-xs text-[#7A746E]">Tarification accessible par pack d'utilisateurs, pensée pour les organisations qui veulent équiper leurs équipes progressivement.</p>
    </div>
    <!-- ... Dupliquer pour chaque pack ... -->
  </div>
</section>
