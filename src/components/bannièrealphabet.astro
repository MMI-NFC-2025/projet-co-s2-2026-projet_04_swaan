---
---
<!-- Bannière Alphabet LSF -->
<section class="py-12 px-6 md:px-20">
  <div class="bg-[#E8E4DF] rounded-2xl shadow-inner p-9 flex flex-col gap-5">
    <div class="text-xs uppercase text-[#ADA8A2] font-medium">Alphabet dactylologique LSF — A à Z</div>
    <div class="flex gap-4 overflow-x-auto pb-1 scrollbar-hide">
      <!-- Exemple de lettre, à dupliquer pour chaque lettre -->
      <div class="shrink-0 w-18 h-22 bg-[#E8E4DF] rounded-xl shadow flex flex-col items-center justify-center gap-1 hover:shadow-inner transition cursor-default">
        <svg viewBox="0 0 44 54" width="36" height="44" fill="none">
          <rect x="8" y="18" width="28" height="22" rx="6" fill="#C4D8B0" opacity="0.5"/>
          <rect x="12" y="10" width="6" height="20" rx="3" fill="#6A8A58"/>
          <rect x="20" y="8" width="6" height="22" rx="3" fill="#6A8A58"/>
          <rect x="28" y="10" width="6" height="20" rx="3" fill="#6A8A58"/>
          <path d="M8 30 C8 26 36 26 36 30 C36 42 30 46 22 46 C14 46 8 42 8 30Z" fill="#8FAF7A" opacity="0.6"/>
          <rect x="6" y="28" width="8" height="14" rx="3" fill="#6A8A58"/>
        </svg>
        <span class="font-serif text-lg text-[#3A3530]">A</span>
      </div>
      <!-- ... Dupliquer pour B, C, D, ... Y ... -->
    </div>
  </div>
</section>
