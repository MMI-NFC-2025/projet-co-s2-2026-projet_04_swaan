---
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";

const {
  title,
  description,
  label = "SWAAN",
  eyebrow = "Page",
  ctaLabel = "Retour à l'accueil",
  ctaHref = "/",
  secondaryLabel,
  secondaryHref,
  children = [],
} = Astro.props;
---

<Layout title={title} description={description}>
  <Nav />

  <main class="px-6 pt-36 pb-16 md:px-12 lg:px-20">
    <section class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div>
        <div class="section-label reveal">{eyebrow}</div>
        <h1 class="reveal max-w-3xl font-serif text-[44px] leading-[1.05] font-light tracking-[-1px] text-dark md:text-[64px]">
          {title.includes("SWAAN") ? title : title}
        </h1>
        <p class="reveal mt-7 max-w-xl text-base leading-8 font-light text-mid">
          {description}
        </p>
        <div class="reveal mt-10 flex flex-col gap-4 sm:flex-row">
          <a class="btn btn-accent w-fit" href={ctaHref}>{ctaLabel}</a>
          {secondaryLabel && secondaryHref && <a class="btn btn-soft w-fit" href={secondaryHref}>{secondaryLabel}</a>}
        </div>
      </div>

      <div class="reveal rounded-[38px] bg-bg p-6 shadow-neu-out-lg">
        <div class="rounded-[30px] bg-bg p-8 shadow-neu-in">
          <p class="mb-3 text-[11px] font-medium tracking-[0.14em] text-soft uppercase">{label}</p>
          <div class="font-serif text-[34px] leading-[1.12] font-light text-dark">
            {eyebrow}
          </div>
          <div class="mt-6 grid gap-4">
            {
              children.map((item) => (
                <div class="rounded-3xl bg-bg p-5 shadow-neu-out">
                  <h2 class="mb-2 text-sm font-medium text-dark">{item.title}</h2>
                  <p class="text-sm leading-7 font-light text-mid">{item.text}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
