<!-- Section "À propos", "Cibles", "Fonctionnalités", "Tarifs", "Essai", "Démo" à compléter ici en Astro + Tailwind -->
<!-- Exemple pour la section "À propos" -->
<section id="apropos" class="py-20 px-6 md:px-20">
  <div class="text-xs uppercase text-[#ADA8A2] font-medium mb-4">À propos</div>
  <h2 class="font-serif text-3xl md:text-5xl font-light text-[#3A3530] mb-12">Une solution pensée pour relier <em class="italic text-[#6A8A58]">formation, accessibilité et inclusion.</em></h2>
  <div class="grid md:grid-cols-2 gap-7">
    <div class="bg-[#E8E4DF] rounded-2xl p-11 shadow hover:shadow-lg transition">
      <div class="w-13 h-13 rounded-xl bg-[#E8E4DF] shadow-inner flex items-center justify-center mb-6">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><path d="M5 12c2.5-4 11.5-4 14 0-2.5 4-11.5 4-14 0Z" stroke="#6A8A58" stroke-width="1.7"/><circle cx="12" cy="12" r="2.5" fill="#C4D8B0"/></svg>
      </div>
      <div class="font-serif text-2xl text-[#3A3530] mb-4">Le projet</div>
      <p class="text-sm text-[#7A746E]">SWAAN aide les organisations à former leurs collaborateurs aux bases de la Langue des Signes Française afin de faciliter la communication avec les personnes sourdes ou malentendantes et de renforcer une culture d'entreprise plus inclusive.</p>
    </div>
    <div class="bg-[#E8E4DF] rounded-2xl p-11 shadow hover:shadow-lg transition">
      <div class="w-13 h-13 rounded-xl bg-[#E8E4DF] shadow-inner flex items-center justify-center mb-6">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none"><rect x="3" y="3" width="18" height="18" rx="4" stroke="#6A8A58" stroke-width="1.7"/><rect x="8" y="8" width="8" height="8" rx="2" fill="#C4D8B0"/></svg>
      </div>
      <div class="font-serif text-2xl text-[#3A3530] mb-4">La promesse</div>
      <p class="text-sm text-[#7A746E]">Une solution simple à déployer, avec des formats courts, un apprentissage progressif et une interface accessible, pensée pour les contraintes du monde professionnel et la valorisation des engagements RSE.</p>
    </div>
  </div>
</section>
