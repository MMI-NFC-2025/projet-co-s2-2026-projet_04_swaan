---
import Layout from "../layouts/Layout.astro";

const {
  title = "Redirection",
  target = "/",
} = Astro.props;
---

<Layout title={title} description="Redirection vers la nouvelle page SWAAN.">
  <main class="flex min-h-screen items-center justify-center bg-bg px-6 text-center text-dark">
    <section class="max-w-xl rounded-[36px] bg-bg p-8 shadow-neu-out-lg">
      <p class="section-label justify-center">Redirection</p>
      <h1 class="font-serif text-[44px] leading-[1.05] font-light text-dark">Cette page a été renommée.</h1>
      <p class="mt-5 text-sm leading-7 font-light text-mid">
        Vous allez être redirigé automatiquement vers la nouvelle adresse.
      </p>
      <a class="btn btn-accent mt-7" href={target}>Ouvrir la page</a>
    </section>
  </main>

  <script define:vars={{ target }}>
    window.location.replace(target + window.location.search + window.location.hash);
  </script>
</Layout>
