---
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { getModules } from "../js/backend.mjs";

const {
  title,
  eyebrow,
  description,
  image = "/assets/img/sign-bonjour-game.png",
  ctaLabel = "Nous contacter",
  ctaHref = "/contact",
  secondaryLabel = "Demander une démo",
  secondaryHref = "/demande-demo",
  highlights = [],
  sections = [],
  cards = [],
  notice,
  showModules = false,
} = Astro.props;

const modules = showModules ? await getModules() : [];
---

<Layout title={title} description={description} image={image}>
  <Nav />

  <main class="px-6 pt-36 pb-16 md:px-12 lg:px-20">
    <section class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-(--grid-two-info) lg:items-center">
      <div>
        <nav class="reveal mb-8 text-sm text-soft" aria-label="Fil d'Ariane">
          <a class="hover:text-dark" href="/">Accueil</a>
          <span class="mx-2">/</span>
          <span>{title}</span>
        </nav>

        <div class="section-label reveal">{eyebrow}</div>
        <h1 class="reveal max-w-3xl font-serif text-display-sm leading-tight font-light tracking-title text-dark md:text-display-xl lg:text-display-3xl">
          {title}
        </h1>
        <p class="reveal mt-7 max-w-xl text-base leading-8 font-light text-mid">
          {description}
        </p>

        <div class="reveal mt-10 flex flex-col gap-4 sm:flex-row">
          <a class="btn btn-accent w-fit" href={ctaHref}>{ctaLabel}</a>
          <a class="btn btn-soft w-fit" href={secondaryHref}>{secondaryLabel}</a>
        </div>
      </div>

      <aside class="reveal rounded-hero-lg bg-bg p-6 shadow-neu-out-lg">
        <div class="rounded-card-lg bg-bg p-5 shadow-neu-in">
          <img class="mx-auto h-72 w-full object-contain md:h-80" src={image} alt={`Illustration ${title}`} loading="eager" />
        </div>
        {
          highlights.length > 0 && (
            <div class="mt-5 grid gap-3 sm:grid-cols-3">
              {highlights.map((item) => (
                <div class="rounded-img bg-bg p-4 text-center shadow-neu-out">
                  <p class="text-10 font-medium tracking-card text-soft uppercase">{item.label}</p>
                  <p class="mt-2 font-serif text-2xl font-light text-dark">{item.value}</p>
                </div>
              ))}
            </div>
          )
        }
      </aside>
    </section>

    {
      notice && (
        <section class="mx-auto mt-12 max-w-7xl">
          <div class="reveal rounded-card-md bg-pop-light/45 p-6 shadow-neu-in-sm md:p-8">
            <p class="mb-2 text-11 font-medium tracking-section text-pop-dark uppercase">{notice.label}</p>
            <p class="max-w-4xl text-sm leading-7 font-light text-mid">{notice.text}</p>
          </div>
        </section>
      )
    }

    {
      cards.length > 0 && (
        <section class="mx-auto mt-16 max-w-7xl">
          <div class="section-label reveal">À retenir</div>
          <div class="grid gap-5 md:grid-cols-3">
            {cards.map((card) => (
              <article class="reveal rounded-card-md bg-bg p-6 shadow-neu-out transition hover:shadow-neu-in">
                <p class="mb-4 text-10 font-medium tracking-section text-soft uppercase">{card.label}</p>
                <h2 class="mb-3 font-serif text-3xl font-light text-dark">{card.title}</h2>
                <p class="text-sm leading-7 font-light text-mid">{card.text}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      showModules && (
        <section class="mx-auto mt-16 max-w-7xl">
          <div class="reveal rounded-card-lg bg-bg p-6 shadow-neu-out-lg md:p-8">
            <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="text-10 font-medium tracking-section text-soft uppercase">Modules PocketBase</p>
                <h2 class="font-serif text-card-xl leading-none font-light text-dark">
                  Parcours de formation.
                </h2>
              </div>
              <span id="modules-count" class="rounded-full bg-bg px-5 py-2.5 text-xs font-medium tracking-nav text-pop-dark uppercase shadow-neu-in-sm">
                {modules.length} {modules.length > 1 ? "modules" : "module"}
              </span>
            </div>
            <div id="modules-list" class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
              {
                modules.length > 0 ? (
                  modules.map((module) => (
                    <article class="rounded-panel bg-bg p-5 shadow-neu-out">
                      <p class="mb-3 text-10 font-medium tracking-section text-soft uppercase">Niveau {module.level || "1"}</p>
                      <h3 class="font-serif text-card-title leading-none font-light text-dark">{module.title || "Module SWAAN"}</h3>
                      <p class="mt-4 text-sm leading-7 font-light text-mid">{module.description || "Module de formation LSF."}</p>
                    </article>
                  ))
                ) : (
                  <article class="rounded-panel bg-bg p-5 shadow-neu-in-sm">
                    <p class="text-sm leading-7 font-light text-mid">Aucun module n'est encore renseigné dans PocketBase.</p>
                  </article>
                )
              }
            </div>
          </div>
        </section>
      )
    }

    {
      sections.length > 0 && (
        <section class="mx-auto mt-16 grid max-w-7xl gap-6 lg:grid-cols-2">
          {sections.map((section) => (
            <article class="reveal rounded-card-lg bg-bg p-6 shadow-neu-out-lg md:p-8">
              <p class="mb-3 text-10 font-medium tracking-section text-soft uppercase">{section.label}</p>
              <h2 class="mb-4 font-serif text-section leading-tight font-light text-dark">{section.title}</h2>
              <p class="mb-6 text-sm leading-7 font-light text-mid">{section.text}</p>
              {section.items && (
                <ul class="grid gap-3">
                  {section.items.map((item) => (
                    <li class="flex gap-3 rounded-soft bg-bg p-4 text-sm leading-6 font-light text-mid shadow-neu-in-sm">
                      <span class="mt-1 flex size-5 shrink-0 items-center justify-center rounded-full bg-pop-light text-10 font-medium text-pop-dark">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </section>
      )
    }
  </main>

  <Footer />
</Layout>
