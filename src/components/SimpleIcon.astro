---
const { type = "circle" } = Astro.props;
---

<div class="mb-6 flex size-13 items-center justify-center rounded-2xl bg-bg shadow-neu-in-sm">
  {
    type === "eye" ? (
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true" focusable="false">
        <path d="M5 12c2.5-4 11.5-4 14 0-2.5 4-11.5 4-14 0Z" stroke="#6A8A58" stroke-width="1.7" />
        <circle cx="12" cy="12" r="2.5" fill="#C4D8B0" />
      </svg>
    ) : type === "square" ? (
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true" focusable="false">
        <rect x="3" y="3" width="18" height="18" rx="4" stroke="#6A8A58" stroke-width="1.7" />
        <rect x="8" y="8" width="8" height="8" rx="2" fill="#C4D8B0" />
      </svg>
    ) : type === "triangle" ? (
      <svg viewBox="0 0 22 22" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
        <polygon points="11,2 20,20 2,20" stroke="#8FAF7A" stroke-width="1.5" stroke-linejoin="round" />
        <polygon points="11,9 16,20 6,20" fill="#C4D8B0" />
      </svg>
    ) : type === "diamond" ? (
      <svg viewBox="0 0 22 22" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
        <path d="M11 2 L20 11 L11 20 L2 11 Z" stroke="#8FAF7A" stroke-width="1.5" stroke-linejoin="round" />
        <path d="M11 7 L15 11 L11 15 L7 11 Z" fill="#C4D8B0" />
      </svg>
    ) : (
      <svg viewBox="0 0 22 22" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="9" stroke="#8FAF7A" stroke-width="1.5" />
        <circle cx="11" cy="11" r="4" fill="#C4D8B0" />
      </svg>
    )
  }
</div>
