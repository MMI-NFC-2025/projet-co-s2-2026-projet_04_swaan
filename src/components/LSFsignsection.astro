<!-- Section Signes illustrés LSF -->
<section class="py-20 px-6 md:px-20 grid md:grid-cols-2 gap-7 items-center">
  <div>
    <div class="text-xs uppercase text-[#ADA8A2] font-medium mb-4">Signes illustrés</div>
    <h2 class="font-serif text-3xl md:text-4xl font-light text-[#3A3530] mb-4">Apprenez les signes du <em class="italic text-[#6A8A58]">quotidien professionnel.</em></h2>
    <p class="text-sm text-[#7A746E] mb-6">Chaque parcours SWAAN commence par les gestes essentiels : bonjour, merci, aide, comprendre… Des signes concrets pour des situations réelles en entreprise.</p>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
    <!-- Exemple de signe, à dupliquer pour chaque mot -->
    <div class="bg-[#E8E4DF] rounded-xl shadow flex flex-col items-center gap-2 p-4 hover:shadow-inner transition">
      <svg viewBox="0 0 80 80" width="48" height="48" fill="none">
        <rect x="28" y="20" width="8" height="28" rx="4" fill="#6A8A58"/>
        <rect x="38" y="16" width="8" height="32" rx="4" fill="#6A8A58"/>
        <rect x="48" y="18" width="8" height="30" rx="4" fill="#6A8A58"/>
        <rect x="58" y="24" width="8" height="24" rx="4" fill="#6A8A58"/>
        <rect x="18" y="30" width="8" height="20" rx="4" fill="#6A8A58"/>
        <path d="M16 48 C16 44 66 44 66 48 C66 60 55 66 41 66 C27 66 16 60 16 48Z" fill="#C4D8B0" opacity="0.7"/>
        <path d="M38 12 C42 6 50 8 50 14" stroke="#8FAF7A" stroke-width="2.5" stroke-linecap="round" fill="none" stroke-dasharray="3 2"/>
      </svg>
      <span class="text-xs font-medium text-[#ADA8A2] uppercase">Bonjour</span>
    </div>
    <!-- ... Dupliquer pour Merci, Aide, Oui, Non, Comprendre ... -->
  </div>
</section>
